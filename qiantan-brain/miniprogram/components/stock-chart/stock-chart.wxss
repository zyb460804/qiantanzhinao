/* stock-chart · 纯 CSS 版样式 */
.sc-list { width: 100%; display: flex; flex-direction: column; gap: 20rpx; padding: 6rpx 0; }
.sc-title { display: block; margin-bottom: 4rpx; color: var(--ink); font-size: 28rpx; font-weight: 700; }
.sc-empty { padding: 40rpx 0; text-align: center; color: var(--muted); font-size: 24rpx; }
.sc-row { display: flex; align-items: center; gap: 16rpx; }
.sc-idx {
  flex: 0 0 44rpx; text-align: center;
  font-family: var(--font-num); font-size: 22rpx; font-weight: 700; color: var(--muted);
}
.sc-idx.is-hi { color: var(--green-800); }
.sc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.sc-line1 { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.sc-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 24rpx; font-weight: 600; }
.sc-qty { flex: 0 0 auto; font-family: var(--font-num); font-size: 24rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.sc-track { height: 12rpx; overflow: hidden; background: var(--paper-3); border-radius: var(--r-pill); }
.sc-fill { height: 100%; border-radius: var(--r-pill); transition: width var(--dur-slow) var(--ease-expo); }
