/* =============================================================
 * 千摊智脑 · 设计系统 v3.0 ——「清爽现代绿」
 * 纯白纸面 + 浅灰画布 + 鲜亮翠绿主导,珊瑚红/暖橙点缀。
 * 本文件为全局令牌与通用组件类,所有页面/组件依赖它。
 * 类名与 v2.2 完全兼容(.card/.btn-primary/.tag/.page-hero…全部保留)。
 * 单位统一使用 rpx(750rpx = 屏幕宽,约 1px≈2rpx)。
 * ============================================================= */

page {
  /* ---------- 中性 · 纯白纸面 + 浅灰画布 ---------- */
  --paper: #ffffff;          /* 卡片纸面 */
  --paper-2: #f5f7f6;        /* 次级纸面 / 凹陷 */
  --paper-3: #eef1ef;        /* 三级纸面 / 骨架屏 */
  --canvas: #f4f6f5;         /* 页面底色 */
  --ink: #171b19;            /* 主文字 */
  --ink-2: #55605b;          /* 次级文字 */
  --muted: #98a29d;          /* 辅助/占位 */
  --line: #e8ecea;           /* 分隔线 */
  --line-soft: #f0f3f1;      /* 更浅分隔 */
  --ring: rgba(15, 40, 30, 0.06);  /* 卡片轻描边色 */

  /* ---------- 品牌 · 鲜亮翠绿(主导) ---------- */
  --green-950: #063c2a;
  --green-800: #008556;
  --green-700: #00a06a;
  --green-600: #00b578;
  --green-500: #16c48a;
  --green-400: #4ed9a6;
  --green-300: #7de4bd;
  --green-200: #aeefd4;
  --green-100: #d8f7e9;
  --green-50:  #edfbf4;

  /* ---------- 点缀 · 珊瑚红(语音 / AI 高亮) ---------- */
  --tomato: #fa5151;
  --tomato-600: #e8443a;
  --tomato-soft: #ffeceb;
  --tomato-ink: #c93a30;

  /* ---------- 点缀 · 暖橙(利润 / 目标提醒) ---------- */
  --corn: #ffa800;
  --corn-600: #f08c00;
  --corn-soft: #fff4e0;
  --corn-ink: #8f5a00;

  /* ---------- 角色色 · 信息蓝 / 紫罗兰(员工角色、配额区分;克制使用) ---------- */
  --info: #3478f6;
  --info-600: #2b64d9;
  --info-soft: #e9f0fe;
  --info-ink: #1e4fb8;
  --grape: #8b5cf6;
  --grape-600: #7346e0;
  --grape-soft: #f1ebfe;
  --grape-ink: #5b32c7;

  /* ---------- 时段皮肤(由根视图 .skin-* 覆盖;默认午市) ---------- */
  --skin-accent: var(--green-600);
  --skin-glow: rgba(0, 181, 120, 0.16);
  --skin-ambient: rgba(0, 181, 120, 0.08);
  --skin-label: "午市";

  /* ---------- 圆角 ---------- */
  --r-xl: 40rpx;
  --r-lg: 32rpx;
  --r-md: 22rpx;
  --r-sm: 14rpx;
  --r-pill: 999rpx;

  /* ---------- 阴影(柔和现代,层次靠明度) ---------- */
  --shadow-sm: 0 2rpx 10rpx rgba(16, 32, 24, 0.04);
  --shadow:    0 10rpx 30rpx rgba(16, 32, 24, 0.06);
  --shadow-lg: 0 20rpx 56rpx rgba(16, 32, 24, 0.10);

  /* ---------- 间距(4px 基准 → rpx) ---------- */
  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --s-6: 48rpx;
  --s-8: 64rpx;
  --s-12: 96rpx;
  --s-16: 128rpx;

  /* ---------- 字体策略 ---------- */
  --font-display: "PingFang SC", -apple-system, "Microsoft YaHei", sans-serif;
  --font-num: "SF Pro Display", "DIN Alternate", -apple-system, "PingFang SC", sans-serif;
  --font-body: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;

  /* ---------- 字号 ---------- */
  --fs-xs: 20rpx;
  --fs-sm: 23rpx;
  --fs-base: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 38rpx;
  --fs-2xl: 46rpx;
  --fs-3xl: 58rpx;
  --fs-hero: 84rpx;   /* 经营台大数字跳级 */

  /* ---------- 动效 ---------- */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  --dur-fast: 0.2s;
  --dur-normal: 0.3s;
  --dur: 0.32s;
  --dur-slow: 0.6s;

  /* ---------- 层级 ---------- */
  --z-base: 1;
  --z-sticky: 50;
  --z-fab: 80;
  --z-drawer: 90;
  --z-toast: 100;

  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view, text, button, input, textarea, picker, canvas, scroll-view, image { box-sizing: border-box; }
button { margin: 0; padding: 0; line-height: normal; }
button::after { border: 0; }

/* =============================================================
 * 布局骨架
 * ============================================================= */
.page-shell { min-height: 100%; padding: var(--s-3) var(--s-3) calc(var(--s-8) + env(safe-area-inset-bottom)); }
.page-pad { padding-left: var(--s-3); padding-right: var(--s-3); }
.safe-bottom { padding-bottom: calc(var(--s-4) + env(safe-area-inset-bottom)); }
.divider { height: 1rpx; background: var(--line); margin: var(--s-2) 0; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }

/* =============================================================
 * 卡片 / 表面(纯白 + 轻描边 + 柔阴影)
 * ============================================================= */
.card {
  position: relative;
  margin: var(--s-2) 0;
  padding: var(--s-3);
  background: var(--paper);
  border: 1rpx solid var(--ring);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
}
.card--pad { padding: var(--s-4); }
.card--flush { padding: 0; overflow: hidden; }
.surface { background: var(--paper); border-radius: var(--r-lg); border: 1rpx solid var(--ring); }
.card--tap:active, .surface--tap:active { transform: scale(0.985); }

/* =============================================================
 * 按钮(≥44px 触控目标,胶囊造型,回弹反馈)
 * ============================================================= */
.btn-primary, .btn-secondary, .btn-ghost, .btn-tomato {
  display: flex; align-items: center; justify-content: center; gap: var(--s-1);
  min-height: 92rpx; padding: 0 var(--s-4);
  border-radius: var(--r-pill); font-size: var(--fs-lg); font-weight: 600;
  transition: transform var(--dur-fast) var(--ease-spring), opacity var(--dur-fast), box-shadow var(--dur-fast);
}
.btn-primary { color: #fff; background: var(--green-600); box-shadow: 0 10rpx 24rpx rgba(0, 181, 120, 0.28); }
.btn-tomato { color: #fff; background: var(--tomato); box-shadow: 0 10rpx 24rpx rgba(250, 81, 81, 0.26); }
.btn-secondary { color: var(--green-700); background: var(--green-50); }
.btn-ghost { color: var(--ink-2); background: var(--paper-2); }
.btn-sm { min-height: 64rpx; padding: 0 var(--s-3); border-radius: var(--r-pill); font-size: var(--fs-sm); }
.btn-block { width: 100%; }
.btn-row { display: flex; gap: var(--s-2); }
.btn-row .btn-primary, .btn-row .btn-secondary, .btn-row .btn-ghost, .btn-row .btn-tomato { flex: 1; }
.btn-primary:active, .btn-tomato:active { transform: scale(0.97); opacity: 0.94; }
.btn-secondary:active, .btn-ghost:active { transform: scale(0.98); opacity: 0.9; }
.btn[disabled], .btn-primary[disabled], .btn-tomato[disabled] { opacity: 0.5; pointer-events: none; }

/* =============================================================
 * 标签 / 芯片 / 胶囊
 * ============================================================= */
.tag { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 var(--s-2); border-radius: var(--r-pill); font-size: var(--fs-xs); font-weight: 600; line-height: 1; }
.tag-green { color: var(--green-700); background: var(--green-50); }
.tag-tomato { color: var(--tomato-ink); background: var(--tomato-soft); }
.tag-corn { color: var(--corn-ink); background: var(--corn-soft); }
.tag-ink { color: var(--ink-2); background: var(--paper-2); }
.chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 10rpx 22rpx; border-radius: var(--r-pill); font-size: var(--fs-sm); font-weight: 600; background: var(--paper); border: 1rpx solid var(--line); color: var(--ink-2); }
.chip--on { background: var(--green-600); color: #fff; border-color: var(--green-600); }
.pill { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx; border-radius: var(--r-pill); font-size: var(--fs-xs); font-weight: 600; }
.pill-soft { background: var(--skin-ambient); color: var(--skin-accent); }

/* 语义色工具类(向后兼容旧 .green/.red/.yellow) */
.green, .color-green { color: var(--green-600) !important; }
.red, .color-red, .color-tomato { color: var(--tomato) !important; }
.yellow, .color-yellow, .color-corn { color: var(--corn-600) !important; }

/* =============================================================
 * 页头 Hero(鲜亮绿渐变,含「呼吸增长环」变体)
 * ============================================================= */
.page-hero {
  position: relative; overflow: hidden;
  padding: 44rpx 36rpx; color: #fff;
  background: linear-gradient(135deg, #00a06a, #06c77f);
  border-radius: var(--r-xl);
  box-shadow: 0 16rpx 40rpx rgba(0, 160, 106, 0.24);
}
.page-hero::after {
  content: ""; position: absolute; right: -70rpx; bottom: -90rpx;
  width: 260rpx; height: 260rpx;
  border: 40rpx solid rgba(255, 255, 255, 0.10); border-radius: 50%;
}
.page-hero--breathing::before {
  content: ""; position: absolute; right: 28rpx; top: 28rpx;
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.28), transparent 70%);
  animation: breathe 4.5s var(--ease-out) infinite;
}
.eyebrow { display: block; margin-bottom: 8rpx; color: rgba(255,255,255,0.78); font-size: var(--fs-xs); letter-spacing: 3rpx; }
.hero-title { display: block; font-family: var(--font-display); font-size: var(--fs-2xl); line-height: 1.2; font-weight: 700; }
.hero-desc { display: block; margin-top: 10rpx; color: rgba(255,255,255,0.82); font-size: var(--fs-sm); }

/* =============================================================
 * 区块标题
 * ============================================================= */
.section-head { display: flex; align-items: center; justify-content: space-between; margin: var(--s-4) 4rpx var(--s-2); }
.section-title { color: var(--ink); font-size: var(--fs-xl); font-weight: 700; font-family: var(--font-display); }
.section-caption { color: var(--muted); font-size: var(--fs-sm); }
.section-link { color: var(--green-600); font-size: var(--fs-sm); font-weight: 600; }
.section-link:active, .tag:active, .chip:active { opacity: 0.66; }

/* =============================================================
 * KPI / 数字(等宽数字,金额一眼读清)
 * ============================================================= */
.kpi { display: flex; flex-direction: column; gap: 4rpx; }
.kpi-value { font-family: var(--font-num); font-weight: 700; font-size: var(--fs-2xl); line-height: 1.05; letter-spacing: -0.5rpx; font-variant-numeric: tabular-nums; }
.kpi-value.is-tomato { color: var(--tomato); }
.kpi-value.is-corn { color: var(--corn-600); }
.kpi-value.is-green { color: var(--green-600); }
.kpi-label { color: var(--muted); font-size: var(--fs-xs); }
.kpi-sub { color: var(--ink-2); font-size: var(--fs-xs); }

/* =============================================================
 * 骨架屏 — 浅灰 + 流光动画
 * ============================================================= */
.skeleton { position: relative; overflow: hidden; background: var(--paper-3); border-radius: var(--r-md); }
.skeleton::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(100deg, transparent 20%, rgba(255,255,255,0.65) 50%, transparent 80%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s ease-in-out infinite;
}
@keyframes sk-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
@keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

.sk-line { height: 22rpx; margin: 14rpx 0; border-radius: 8rpx; background: #e3e7e5; display: block; }
.sk-block { height: 200rpx; border-radius: var(--r-lg); background: var(--paper-3); position: relative; overflow: hidden; }
.sk-circle { border-radius: 50%; }

/* 骨架屏布局 — 极简版 */
.skeleton-wrap { padding: 32rpx; }
.sk-hero {
  margin-bottom: 32rpx; padding: 32rpx;
  background: #d9efe6; border-radius: 24rpx;
}
.sk-grid { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.sk-card {
  flex: 1; height: 180rpx;
  background: var(--paper-3); border-radius: 20rpx;
}
.sk-ring {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #dce1de; margin: 12rpx auto;
}
.w60 { width: 60%; }
.w40 { width: 40%; }
.w80 { width: 80%; }
.w50 { width: 50%; }

/* =============================================================
 * 浮动语音按钮(FAB) + 涟漪
 * ============================================================= */
.fab {
  position: fixed; z-index: var(--z-fab);
  right: var(--s-4); bottom: calc(var(--s-8) + env(safe-area-inset-bottom));
  display: flex; align-items: center; justify-content: center;
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: linear-gradient(160deg, #00b578, #00a06a); color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(0, 181, 120, 0.38);
  transition: transform var(--dur-fast) var(--ease-spring);
}
.fab:active { transform: scale(0.92); }
.fab--pulse::before {
  content: ""; position: absolute; inset: 0; border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(0, 181, 120, 0.40);
  animation: fab-pulse 2.4s var(--ease-out) infinite;
}

/* =============================================================
 * 空状态
 * ============================================================= */
.empty-state { padding: var(--s-12) var(--s-4); text-align: center; color: var(--muted); }
.empty-icon { display: block; margin: 0 auto var(--s-2); }
.empty-title { color: var(--ink-2); font-size: var(--fs-lg); font-weight: 700; }
.empty-desc { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.6; }

/* =============================================================
 * Toast / 轻提示
 * ============================================================= */
.toast-mask { position: fixed; inset: 0; z-index: var(--z-toast); display: flex; align-items: center; justify-content: center; pointer-events: none; }
.toast-box {
  max-width: 70%; padding: var(--s-2) var(--s-3);
  background: rgba(23, 27, 25, 0.92); color: #fff;
  border-radius: var(--r-md); font-size: var(--fs-sm); text-align: center;
  box-shadow: var(--shadow-lg); animation: pop-in var(--dur) var(--ease-spring);
}

/* =============================================================
 * 主动洞察卡(小智今日洞察)
 * ============================================================= */
.insight {
  display: flex; gap: var(--s-2); padding: var(--s-3);
  background: linear-gradient(135deg, var(--green-50), var(--paper));
  border: 1rpx solid var(--green-100); border-radius: var(--r-lg);
}
.insight + .insight { margin-top: var(--s-2); }
.insight-body { flex: 1; }
.insight-title { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.insight-desc { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.55; }
.insight-accept { align-self: center; }

/* =============================================================
 * 时段皮肤(根视图加 .skin-*;背景光晕平滑过渡)
 * ============================================================= */
.skin-morning {
  --skin-accent: #00b9a8; --skin-glow: rgba(0, 185, 168, 0.16);
  --skin-ambient: rgba(0, 185, 168, 0.10); --skin-label: "早市";
}
.skin-noon {
  --skin-accent: var(--green-600); --skin-glow: rgba(0, 181, 120, 0.16);
  --skin-ambient: rgba(0, 181, 120, 0.08); --skin-label: "午市";
}
.skin-evening {
  --skin-accent: #f08c00; --skin-glow: rgba(255, 168, 0, 0.18);
  --skin-ambient: rgba(255, 168, 0, 0.12); --skin-label: "晚市";
}
/* 时段氛围层:贴在根视图顶部的柔光 */
.skin-ambient-layer {
  position: fixed; left: 0; right: 0; top: 0; height: 420rpx; z-index: 0;
  background: radial-gradient(120% 80% at 50% -10%, var(--skin-glow), transparent 70%);
  pointer-events: none; transition: background var(--dur-slow) var(--ease-out);
}

/* =============================================================
 * 深色模式(明度分层,非反相)
 * ============================================================= */
.ui-dark {
  --paper: #1b201e;
  --paper-2: #151a18;
  --paper-3: #101513;
  --canvas: #0f1412;
  --ink: #e9efec;
  --ink-2: #a7b2ac;
  --muted: #6d7873;
  --line: #2a312d;
  --line-soft: #222926;
  --ring: rgba(220, 240, 232, 0.08);
  --green-50: #14291f;
  --green-100: #1a3a2b;
  --tomato-soft: #3a1e1c;
  --corn-soft: #3a2c12;
  --info-soft: #1a2540;
  --grape-soft: #271f3e;
  --shadow-sm: 0 4rpx 14rpx rgba(0,0,0,0.4);
  --shadow: 0 14rpx 34rpx rgba(0,0,0,0.5);
  --shadow-lg: 0 24rpx 60rpx rgba(0,0,0,0.6);
}
.ui-dark .page-hero { background: linear-gradient(135deg, #045c3c, #00885a); }
.ui-dark .card, .ui-dark .surface { background: var(--paper); }
.ui-dark .skeleton { background: var(--paper-2); }

/* =============================================================
 * 关键帧
 * ============================================================= */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes breathe { 0%,100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.14); opacity: 1; } }
@keyframes fab-pulse { 0% { box-shadow: 0 0 0 0 rgba(0,181,120,0.40); } 70% { box-shadow: 0 0 0 26rpx rgba(0,181,120,0); } 100% { box-shadow: 0 0 0 0 rgba(0,181,120,0); } }
@keyframes pop-in { 0% { opacity: 0; transform: scale(0.9) translateY(8rpx); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes float-y { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
@keyframes count-pulse { 0% { transform: scale(1); } 40% { transform: scale(1.06); } 100% { transform: scale(1); } }

/* 屏内错落入场(子元素加 .stagger 顺序上浮) */
.stagger { opacity: 0; transform: translateY(16rpx); animation: pop-in var(--dur) var(--ease-expo) forwards; }
.stagger:nth-child(1) { animation-delay: 0.04s; }
.stagger:nth-child(2) { animation-delay: 0.10s; }
.stagger:nth-child(3) { animation-delay: 0.16s; }
.stagger:nth-child(4) { animation-delay: 0.22s; }
.stagger:nth-child(5) { animation-delay: 0.28s; }
.stagger:nth-child(6) { animation-delay: 0.34s; }

/* =============================================================
 * 动效偏好降级(无障碍)
 * 注:WXSS 不支持 @media;也不支持 * 通配选择器,改用常见标签枚举。
 * 使用方式:在 page 节点加 class="reduce-motion" 即可关闭动效。
 * ============================================================= */
.reduce-motion view, .reduce-motion view::before, .reduce-motion view::after,
.reduce-motion text, .reduce-motion text::before, .reduce-motion text::after,
.reduce-motion button, .reduce-motion image, .reduce-motion input,
.reduce-motion textarea, .reduce-motion scroll-view, .reduce-motion swiper,
.reduce-motion canvas, .reduce-motion cover-view, .reduce-motion cover-image {
  animation: none !important; transition: none !important;
}

/* =============================================================
 * 表单字段(统一 staff/supplier 等管理页的录入控件)
 * ============================================================= */
.form-field { display: flex; flex-direction: column; gap: 10rpx; }
.form-label { display: flex; align-items: center; gap: 6rpx; font-size: 25rpx; font-weight: 600; color: var(--ink-2); }
.form-label .required { color: var(--tomato); }
.form-input, .form-picker {
  width: 100%; min-height: 84rpx; padding: 0 20rpx;
  background: var(--paper-2); border: 1rpx solid transparent;
  border-radius: var(--r-md); font-size: 28rpx; color: var(--ink);
  transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
}
.form-picker { display: flex; align-items: center; }
.form-input:focus, .form-picker:focus { border-color: var(--green-500); background: var(--paper); }
.form-input.has-error, .form-picker.has-error { border-color: var(--tomato); background: var(--tomato-soft); }
.form-error { display: block; margin-top: 4rpx; font-size: 21rpx; color: var(--tomato); }
.form-hint { display: block; font-size: 22rpx; color: var(--muted); }

/* =============================================================
 * 居中弹窗 / 对话框(统一 staff 等页的新增编辑弹层)
 * ============================================================= */
.dialog-mask {
  position: fixed; inset: 0; z-index: var(--z-drawer);
  display: flex; align-items: center; justify-content: center;
  background: rgba(15, 24, 20, 0.45);
  animation: fade-in var(--dur-fast) var(--ease-out);
}
.dialog {
  width: 620rpx; max-height: 82%; overflow-y: auto;
  padding: 40rpx 36rpx; background: var(--paper);
  border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  display: flex; flex-direction: column; gap: 24rpx;
  animation: pop-in var(--dur) var(--ease-spring);
}
.dialog-title { font-size: var(--fs-xl); font-weight: 700; color: var(--ink); text-align: center; }
.dialog-actions { display: flex; gap: var(--s-2); justify-content: flex-end; margin-top: var(--s-1); }
.dialog-actions .btn-primary, .dialog-actions .btn-secondary, .dialog-actions .btn-tomato { flex: 1; }

/* =============================================================
 * 分段选项卡(统一 tenant 等页的 Tab 切换)
 * ============================================================= */
.seg-tabs {
  display: flex; margin: 0 var(--s-3); padding-bottom: 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.seg-tab {
  position: relative; flex: 1; text-align: center;
  padding: 24rpx 0; color: var(--muted); font-size: var(--fs-base);
  transition: color var(--dur-fast) var(--ease-out);
}
.seg-tab.is-active { color: var(--green-700); font-weight: 700; }
.seg-tab.is-active::after {
  content: ""; position: absolute; bottom: -2rpx; left: 30%; right: 30%;
  height: 6rpx; border-radius: var(--r-pill);
  background: var(--green-600); transition: background var(--dur-slow) var(--ease-out);
}

/* =============================================================
 * 角色头像(统一 staff/supplier 的圆形象征色头像)
 * 取值全部来自令牌,避免硬编码。
 * ============================================================= */
.avatar { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; font-weight: 800; }
.avatar--green { background: var(--green-600); }
.avatar--corn { background: var(--corn); color: #fff; }
.avatar--tomato { background: var(--tomato); }
.avatar--info { background: var(--info); }
.avatar--grape { background: var(--grape); }
.avatar--muted { background: var(--muted); }

/* =============================================================
 * 向后兼容别名层(现有页面 / 组件仍引用旧名,勿删)
 * 新页面请直接用新令牌(--corn/--tomato/--r-* 等)。
 * ============================================================= */
page {
  --amber: var(--corn);
  --amber-soft: var(--corn-soft);
  --red: var(--tomato);
  --red-soft: var(--tomato-soft);
  --blue: var(--info);
  --radius-xl: var(--r-xl);
  --radius-lg: var(--r-lg);
  --radius-md: var(--r-md);
  --radius-sm: var(--r-sm);
}
.tag-amber { color: var(--corn-ink); background: var(--corn-soft); }
.tag-red { color: var(--tomato-ink); background: var(--tomato-soft); }
