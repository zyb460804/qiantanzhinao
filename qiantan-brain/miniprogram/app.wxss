/* =============================================================
 * 千摊智脑 · 设计系统 v5.0 ——「鲜 · 晨光菜市」
 * ----------------------------------------------------------------
 * 全新设计语言（2026-09 重设计，不受 v4 视觉约束）：
 *   · 主色：鲜青菜绿 #1B7A44（水灵、有生机，一眼是"卖菜的"）
 *   · 点缀：价签红 #D93A2B（金额/警示）+ 麦穗金 #D99A26（利润/目标）
 *   · 纸面：冷调白瓷 + 浅灰绿画布，宋体数字 = 账本/价签的记号
 *   · 招牌：hero 是"傍晚菜场的灯箱"——顶部柔光 + 点阵纹理 + 底部收暗
 *   · 签名元素：小票撕边卡（.card--ticket）、红印章（.stamp）、虚线撕线
 *
 * 借鉴来源：
 *   shadcn/ui  → 语义 token 层、hairline + 双层阴影、组件克制精致
 *   Radix UI   → 弹层/表单的交互状态（focus ring、mask、grabber）
 *   Aceternity/Magic UI → 氛围光、扫光、入场编排（全部纯 CSS、克制使用）
 *   Tremor     → stat 卡 + mini 柱状图的数据展示模式
 *
 * 动效政策：
 *   常开：按压反馈 / 骨架流光 / switch·progress 过渡 / pop-in
 *   编排：.rise（页头入场）+ .stagger--on（列表逐项入场），按页启用
 *   氛围：.btn--sheen 扫光 / .fab--pulse 呼吸光，只允许主 CTA 与 FAB
 *   .reduce-motion 一键全关。
 *
 * 兼容性说明：v4 的类名与令牌名视为"页面 API"全部保留（值可变），
 * 页面/组件层零改动即可整体换肤。
 * WXSS 禁用：@media / :root / * 通配 / vh-vw-rem / 本地 url()。
 * 单位统一 rpx（750rpx = 屏宽，1px ≈ 2rpx）。
 * ============================================================= */

page {
  /* ================= 中性 · 白瓷纸面 ================= */
  --canvas: #f3f5f1;         /* 页面底 · 浅灰绿画布 */
  --paper: #ffffff;          /* 卡片纸面 · 纯白 */
  --paper-2: #f7f8f5;        /* 凹陷/输入底 */
  --paper-3: #eaede6;        /* 骨架/三级面 */
  --ink: #17201a;            /* 主文字 · 绿调墨黑 */
  --ink-2: #4a554e;          /* 次级文字 */
  --muted: #66706a;          /* 辅助/占位 · QA-37 从 #87918a 加深：白底 5.13:1、画布底 4.68:1、输入底 4.82:1，全部 ≥AA 4.5:1 */
  --line: #e2e6df;           /* 分隔线 */
  --line-soft: #eef1ea;      /* 浅分隔 */
  --ring: rgba(23, 32, 26, 0.08);   /* hairline 描边 */

  /* ================= 品牌 · 鲜青菜绿 ================= */
  --green-950: #0a2317;
  --green-900: #0f3320;
  --green-800: #14502e;
  --green-700: #1b7a44;      /* 主色 primary */
  --green-600: #24914f;
  --green-500: #34a85e;
  --green-400: #57c17c;
  --green-300: #8ad8a5;
  --green-200: #b9e8c8;
  --green-100: #ddf4e3;
  --green-50: #eff9f1;

  /* ================= 点缀 · 价签红 ================= */
  --tomato: #d93a2b;
  --tomato-600: #bc2f22;
  --tomato-soft: #fdeae7;
  --tomato-ink: #96261b;

  /* ================= 点缀 · 麦穗金 ================= */
  --corn: #d99a26;
  --corn-600: #bc8315;
  --corn-soft: #fbf0d7;
  --corn-ink: #7a5410;

  /* ================= 角色色 · 信息蓝 / 紫罗兰 ================= */
  --info: #2f6bc4;
  --info-600: #2557a3;
  --info-soft: #e8f0fa;
  --info-ink: #1d4585;
  --grape: #7050b8;
  --grape-600: #5c3f9c;
  --grape-soft: #efeaf8;
  --grape-ink: #4a3380;

  /* ================= 时段皮肤（.skin-* 覆盖） ================= */
  --skin-accent: var(--green-700);
  --skin-glow: rgba(27, 122, 68, 0.10);
  --skin-ambient: rgba(27, 122, 68, 0.06);
  --skin-label: "午市";

  /* ================= 招牌（hero）专用 ================= */
  --hero-grad: linear-gradient(168deg, #23914e 0%, var(--green-700) 46%, var(--green-800) 100%);
  --hero-dot: rgba(255, 255, 255, 0.10);
  --hero-glow: 0 10rpx 30rpx rgba(20, 80, 46, 0.22);

  /* ================= 圆角（白瓷器 · 挺括） ================= */
  --r-xl: 28rpx;
  --r-lg: 20rpx;
  --r-md: 14rpx;
  --r-sm: 10rpx;
  --r-pill: 999rpx;

  /* ================= 阴影（环境光 + 主光 双层） ================= */
  --shadow-sm: 0 1rpx 3rpx rgba(15, 40, 25, 0.05), 0 2rpx 8rpx rgba(15, 40, 25, 0.04);
  --shadow:    0 2rpx 6rpx rgba(15, 40, 25, 0.05), 0 8rpx 24rpx rgba(15, 40, 25, 0.07);
  --shadow-lg: 0 6rpx 16rpx rgba(15, 40, 25, 0.07), 0 20rpx 48rpx rgba(15, 40, 25, 0.12);
  --glow-primary: 0 4rpx 12rpx rgba(27, 122, 68, 0.22);

  /* ================= 间距（8rpx 基准） ================= */
  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --s-5: 40rpx;
  --s-6: 48rpx;
  --s-8: 64rpx;
  --s-12: 96rpx;
  --s-16: 128rpx;

  /* ================= 字体 =================
   * 金额/数字用宋体——价签感、账本感，摊主最熟悉的数字形态。
   */
  --font-display: "PingFang SC", -apple-system, "Microsoft YaHei", sans-serif;
  --font-num: "Songti SC", "STSong", "Noto Serif SC", "SimSun", serif;
  --font-body: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;

  /* ================= 字号（对比拉大的阶梯） ================= */
  --fs-xs: 20rpx;
  --fs-sm: 23rpx;
  --fs-base: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 38rpx;
  --fs-2xl: 46rpx;
  --fs-3xl: 58rpx;
  --fs-hero: 84rpx;

  /* ================= 动效 ================= */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  --dur-fast: 0.18s;
  --dur-normal: 0.26s;
  --dur: 0.28s;
  --dur-slow: 0.5s;

  /* ================= 层级 ================= */
  --z-base: 1;
  --z-sticky: 50;
  --z-fab: 80;
  --z-drawer: 90;
  --z-toast: 100;

  /* ================= shadcn 语义别名层 =================
   * 给熟悉 shadcn/ui 的同学同一套词汇表；全部映射物理令牌。
   */
  --background: var(--canvas);
  --foreground: var(--ink);
  --card: var(--paper);
  --card-foreground: var(--ink);
  --primary: var(--green-700);
  --primary-foreground: #ffffff;
  --secondary: var(--green-50);
  --secondary-foreground: var(--green-700);
  --muted-foreground: var(--muted);
  --accent: var(--green-100);
  --accent-foreground: var(--green-800);
  --destructive: var(--tomato);
  --destructive-foreground: #ffffff;
  --border: var(--line);
  --input-bg: var(--paper-2);
  --focus-ring: 0 0 0 6rpx rgba(27, 122, 68, 0.16);

  min-height: 100%;
  background:
    radial-gradient(120% 46% at 50% -6%, var(--skin-ambient), transparent 70%),
    var(--canvas);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view, text, button, input, textarea, picker, canvas, scroll-view, image { box-sizing: border-box; }
button { margin: 0; padding: 0; line-height: normal; }
button::after { border: 0; }

/* =============================================================
 * 布局骨架
 * ============================================================= */
.page-shell { min-height: 100%; padding: var(--s-3) var(--s-3) calc(var(--s-8) + env(safe-area-inset-bottom)); }
.page-pad { padding-left: var(--s-3); padding-right: var(--s-3); }
.safe-bottom { padding-bottom: calc(var(--s-4) + env(safe-area-inset-bottom)); }
.divider { height: 1rpx; background: var(--line); margin: var(--s-2) 0; }
.divider--dashed { height: 0; border-top: 2rpx dashed var(--line); }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }

/* 文本工具 */
.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.strong { font-weight: 700; color: var(--ink); }
.muted-text { color: var(--muted); }

/* =============================================================
 * 卡片 / 表面 —— 白瓷卡片：hairline + 双层柔影
 * ============================================================= */
.card {
  position: relative;
  margin: var(--s-2) 0;
  padding: var(--s-3);
  background: var(--paper);
  border: 1rpx solid var(--ring);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
}
.card--pad { padding: var(--s-4); }
.card--flush { padding: 0; overflow: hidden; }
.surface { background: var(--paper); border-radius: var(--r-lg); border: 1rpx solid var(--ring); }
.card--tap:active, .surface--tap:active { transform: translateY(2rpx) scale(0.985); box-shadow: var(--shadow); }
/* 浮起：给最重要的那张卡（今日金额、核心 KPI） */
.card--lift { box-shadow: var(--shadow); }

/* ---------- 签名元素 · 小票撕边卡 ----------
 * 用法：<view class="card card--ticket"> …内容… </view>
 * 底部锯齿撕边 + 卡内最后一行用 .divider--dashed 隔开，即成一张小票。
 */
.card--ticket { padding-bottom: var(--s-4); border-bottom-left-radius: var(--r-sm); border-bottom-right-radius: var(--r-sm); }
.card--ticket::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -8rpx; height: 9rpx;
  background:
    linear-gradient(-45deg, var(--paper) 6rpx, transparent 0) left bottom,
    linear-gradient(45deg, var(--paper) 6rpx, transparent 0) left bottom;
  background-size: 12rpx 9rpx;
  background-repeat: repeat-x;
  filter: drop-shadow(0 2rpx 3rpx rgba(15, 40, 25, 0.06));
}
.ui-dark .card--ticket::after {
  background:
    linear-gradient(-45deg, var(--paper) 6rpx, transparent 0) left bottom,
    linear-gradient(45deg, var(--paper) 6rpx, transparent 0) left bottom;
  background-size: 12rpx 9rpx; background-repeat: repeat-x; filter: none;
}

/* ---------- 签名元素 · 价签红印章 ----------
 * 用法：<view class="stamp">已核销</view>
 */
.stamp {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx;
  color: var(--tomato);
  border: 3rpx solid currentColor; border-radius: var(--r-sm);
  font-size: var(--fs-sm); font-weight: 800; letter-spacing: 4rpx;
  transform: rotate(-6deg); opacity: 0.85;
}

/* =============================================================
 * 横幅（info / warn / danger / success）
 * ============================================================= */
.banner { display: flex; align-items: flex-start; gap: var(--s-2); margin: var(--s-2) 0; padding: var(--s-2) var(--s-3); border-radius: var(--r-md); font-size: var(--fs-sm); line-height: 1.5; }
.banner-info { color: var(--info-ink); background: var(--info-soft); }
.banner-warn { color: var(--corn-ink); background: var(--corn-soft); }
.banner-danger { color: var(--tomato-ink); background: var(--tomato-soft); }
.banner-success { color: var(--green-800); background: var(--green-50); }

/* =============================================================
 * 按钮 —— 胶囊 · ≥44px 触控 · 主按钮带内高光与品牌辉光
 * ============================================================= */
.btn-primary, .btn-secondary, .btn-ghost, .btn-tomato, .btn-outline, .btn-link {
  display: flex; align-items: center; justify-content: center; gap: var(--s-1);
  min-height: 92rpx; padding: 0 var(--s-4);
  border-radius: var(--r-pill); font-size: var(--fs-lg); font-weight: 600;
  transition: transform var(--dur-fast) var(--ease-spring), opacity var(--dur-fast), box-shadow var(--dur-fast);
}
.btn-primary {
  color: var(--primary-foreground); background: var(--primary);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.16), var(--glow-primary);
}
.btn-tomato {
  color: var(--destructive-foreground); background: var(--destructive);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.14), 0 4rpx 12rpx rgba(217, 58, 43, 0.22);
}
.btn-secondary { color: var(--secondary-foreground); background: var(--secondary); }
.btn-ghost { color: var(--ink-2); background: var(--paper-2); }
.btn-outline { color: var(--ink-2); background: var(--paper); border: 2rpx solid var(--line); }
.btn-link { min-height: 64rpx; padding: 0 8rpx; color: var(--primary); background: transparent; font-size: var(--fs-base); }
.btn-link:active { opacity: 0.6; }
.btn-sm { min-height: 64rpx; padding: 0 var(--s-3); border-radius: var(--r-pill); font-size: var(--fs-sm); }
.btn-lg { min-height: 104rpx; font-size: var(--fs-xl); }
.btn-block { width: 100%; }
.btn-row { display: flex; gap: var(--s-2); }
.btn-row .btn-primary, .btn-row .btn-secondary, .btn-row .btn-ghost, .btn-row .btn-tomato, .btn-row .btn-outline { flex: 1; }
.btn-primary:active, .btn-tomato:active { transform: scale(0.97); opacity: 0.92; }
.btn-secondary:active, .btn-ghost:active, .btn-outline:active { transform: scale(0.98); opacity: 0.88; }
.btn[disabled], .btn-primary[disabled], .btn-tomato[disabled] { opacity: 0.5; pointer-events: none; }
/* 圆形图标按钮（次级动作） */
.btn-icon {
  display: flex; align-items: center; justify-content: center;
  width: 76rpx; height: 76rpx; border-radius: 50%;
  color: var(--ink-2); background: var(--paper); border: 1rpx solid var(--ring);
  box-shadow: var(--shadow-sm);
}
.btn-icon:active { transform: scale(0.94); }

/* ---------- 氛围 · 扫光（只给主 CTA；配 .btn--sheen） ---------- */
.btn--sheen { position: relative; overflow: hidden; }
.btn--sheen::after {
  content: ""; position: absolute; top: 0; bottom: 0; left: -45%; width: 36%;
  transform: skewX(-20deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.30), transparent);
  animation: sheen 3.4s var(--ease-out) 1.1s infinite;
}

/* =============================================================
 * 标签 / 徽章 / 芯片 / 胶囊
 * ============================================================= */
.tag { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 var(--s-2); border-radius: var(--r-sm); font-size: var(--fs-xs); font-weight: 600; line-height: 1; }
.tag-green { color: var(--green-700); background: var(--green-50); }
.tag-tomato { color: var(--tomato-ink); background: var(--tomato-soft); }
.tag-corn { color: var(--corn-ink); background: var(--corn-soft); }
.tag-ink { color: var(--ink-2); background: var(--paper-2); }

/* badge：shadcn 式实心徽章，用于计数/状态 */
.badge { display: inline-flex; align-items: center; justify-content: center; min-width: 34rpx; height: 34rpx; padding: 0 10rpx; border-radius: var(--r-pill); font-size: 20rpx; font-weight: 700; line-height: 1; color: var(--primary-foreground); background: var(--primary); }
.badge-tomato { background: var(--tomato); }
.badge-corn { background: var(--corn); }
.badge-ink { background: var(--ink-2); }
.badge-outline { color: var(--ink-2); background: var(--paper); border: 1rpx solid var(--line); }

.chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 10rpx 22rpx; border-radius: var(--r-pill); font-size: var(--fs-sm); font-weight: 600; background: var(--paper); border: 1rpx solid var(--line); color: var(--ink-2); white-space: nowrap; flex: 0 0 auto; }
.chip--on { background: var(--primary); color: #fff; border-color: var(--primary); box-shadow: var(--glow-primary); }
.pill { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx; border-radius: var(--r-pill); font-size: var(--fs-xs); font-weight: 600; }
.pill-soft { background: var(--skin-ambient); color: var(--skin-accent); }

/* 语义色工具类(向后兼容旧 .green/.red/.yellow) */
.green, .color-green { color: var(--green-700) !important; }
.red, .color-red, .color-tomato { color: var(--tomato) !important; }
.yellow, .color-yellow, .color-corn { color: var(--corn-600) !important; }

/* =============================================================
 * 页头 Hero —— 「傍晚菜场的灯箱」
 * 绿招牌渐变 + 顶部柔光(::before) + 点阵纹理(::after)，无图片。
 * ============================================================= */
.page-hero {
  position: relative; overflow: hidden;
  padding: 40rpx 32rpx; color: #fff;
  background: var(--hero-grad);
  border-radius: var(--r-xl);
  box-shadow: var(--hero-glow);
}
.page-hero::before {
  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background: radial-gradient(90% 64% at 16% -12%, rgba(255, 255, 255, 0.20), transparent 62%);
}
.page-hero::after {
  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    radial-gradient(var(--hero-dot) 1.5rpx, transparent 1.5rpx),
    linear-gradient(180deg, transparent 0%, var(--green-950) 160%);
  background-size: 26rpx 26rpx, 100% 100%;
  opacity: 0.55;
}
/* 旧类保留：呼吸光圈已由灯箱氛围取代 */
.page-hero--breathing::before { animation: none; }
/* 氛围层(::before/::after)之上：hero 直接子元素整体提到 z-2 */
.page-hero > view, .page-hero > text, .page-hero > button { position: relative; z-index: 2; }
.eyebrow { display: block; margin-bottom: 8rpx; color: rgba(255, 255, 255, 0.72); font-size: var(--fs-xs); letter-spacing: 3rpx; position: relative; z-index: 2; }
.hero-title { display: block; font-family: var(--font-display); font-size: var(--fs-2xl); line-height: 1.25; font-weight: 700; letter-spacing: 0.5rpx; position: relative; z-index: 2; }
.hero-desc { display: block; margin-top: 10rpx; color: rgba(255, 255, 255, 0.82); font-size: var(--fs-sm); line-height: 1.5; position: relative; z-index: 2; }

/* ---------- Hero 数据 DNA（金额/统计行） ---------- */
.hero-amount {
  display: block; margin-top: 16rpx; position: relative; z-index: 2;
  font-family: var(--font-num);
  font-size: 62rpx; font-weight: 800; color: #fff;
  letter-spacing: -2rpx; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.hero-amount-label { display: block; margin-top: 6rpx; color: rgba(255, 255, 255, 0.72); font-size: 24rpx; position: relative; z-index: 2; }
.hero-stats { position: relative; z-index: 2; display: flex; gap: 18rpx; margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.14); }
.hero-stat { flex: 1; text-align: center; }
.hero-stat-num { display: block; font-family: var(--font-num); font-size: 34rpx; font-weight: 750; color: #fff; font-variant-numeric: tabular-nums; }
.hero-stat-num.is-warn { color: #ffc79e; }
.hero-stat-num.is-up { color: #8fe8ac; }
.hero-stat-num.is-down { color: #ffc79e; }
.hero-stat-label { display: block; margin-top: 4rpx; color: rgba(255, 255, 255, 0.62); font-size: 22rpx; }

/* =============================================================
 * 区块标题（v5.2 排版精修：接近律——标题贴内容，上方留呼吸）
 * ============================================================= */
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: var(--s-4) 4rpx 12rpx; }
.section-title { color: var(--ink); font-size: 32rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0.5rpx; font-family: var(--font-display); }
.section-caption { color: var(--muted); font-size: var(--fs-sm); }
.section-link { color: var(--primary); font-size: var(--fs-sm); font-weight: 600; }
.section-link:active, .tag:active, .chip:active { opacity: 0.66; }

/* =============================================================
 * 排版词汇表（v5.2 · 对齐 shadcn 的 Typography 层级）
 * 用法：不满足于默认样式时，用这些类表达文字的角色而非手写字号。
 * ============================================================= */
.t-overline { display: block; color: var(--muted); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 3rpx; }
.t-title { display: block; color: var(--ink); font-size: 32rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0.5rpx; }
.t-card-title { display: block; color: var(--ink); font-size: var(--fs-base); font-weight: 700; line-height: 1.4; }
.t-body { display: block; color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.6; }
.t-caption { display: block; color: var(--muted); font-size: var(--fs-xs); line-height: 1.5; }
.t-num-xl { display: block; color: var(--ink); font-family: var(--font-num); font-size: var(--fs-2xl); font-weight: 800; line-height: 1.05; letter-spacing: -0.5rpx; font-variant-numeric: tabular-nums; }

/* =============================================================
 * 布局原语（v5.2 · 垂直堆叠 / 两列网格）
 * ============================================================= */
.stack { display: flex; flex-direction: column; gap: var(--s-2); }
.stack-tight { display: flex; flex-direction: column; gap: var(--s-1); }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); }

/* =============================================================
 * KPI / 数据卡
 * ============================================================= */
.kpi { display: flex; flex-direction: column; gap: 6rpx; }
.kpi-value { font-family: var(--font-num); font-weight: 700; font-size: var(--fs-2xl); line-height: 1.05; letter-spacing: -0.5rpx; font-variant-numeric: tabular-nums; }
.kpi-value.is-tomato { color: var(--tomato); }
.kpi-value.is-corn { color: var(--corn-600); }
.kpi-value.is-green { color: var(--green-700); }
.kpi-label { color: var(--muted); font-size: var(--fs-xs); letter-spacing: 0.5rpx; }
.kpi-sub { color: var(--ink-2); font-size: var(--fs-xs); }

/* stat 卡：标题 + 大数字 + mini 柱状趋势（Tremor 模式） */
.stat-card { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-3); background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
.stat-title { color: var(--muted); font-size: var(--fs-xs); font-weight: 600; }
.stat-value { font-family: var(--font-num); font-size: var(--fs-2xl); font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1.05; }
.stat-note { color: var(--muted); font-size: var(--fs-xs); }
.mini-bars { display: flex; align-items: flex-end; gap: 8rpx; height: 64rpx; }
.mini-bars > view { flex: 1; min-height: 6rpx; border-radius: 4rpx 4rpx 0 0; background: linear-gradient(180deg, var(--green-400), var(--green-600)); opacity: 0.9; }
.mini-bars > view.is-hi { background: linear-gradient(180deg, var(--green-500), var(--green-700)); opacity: 1; }
.mini-bars > view.is-dim { background: var(--green-100); }
.mini-bars--tomato > view { background: linear-gradient(180deg, #ef7b6c, var(--tomato-600)); }
.mini-bars--corn > view { background: linear-gradient(180deg, #e7b95e, var(--corn-600)); }

/* =============================================================
 * 进度条
 * ============================================================= */
.progress { height: 14rpx; background: var(--paper-3); border-radius: var(--r-pill); overflow: hidden; }
.progress-bar { height: 100%; border-radius: var(--r-pill); background: linear-gradient(90deg, var(--green-500), var(--green-700)); transition: width var(--dur-slow) var(--ease-expo); }
.progress-bar--tomato { background: linear-gradient(90deg, #ef7b6c, var(--tomato-600)); }
.progress-bar--corn { background: linear-gradient(90deg, #e7b95e, var(--corn-600)); }
/* 条纹流动（可选装饰） */
.progress--striped .progress-bar {
  background-image:
    linear-gradient(90deg, var(--green-500), var(--green-700)),
    repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.22) 0 8rpx, transparent 8rpx 16rpx);
  background-blend-mode: overlay;
}

/* =============================================================
 * 分段选项卡（两种形态）
 * 1) .seg-tabs 下划线式（沿用旧类名）
 * 2) .seg 胶囊容器式（shadcn Tabs 观感）
 * ============================================================= */
.seg-tabs { display: flex; margin: 0 var(--s-3); padding-bottom: 4rpx; border-bottom: 1rpx solid var(--line); }
.seg-tab { position: relative; flex: 1; text-align: center; padding: 24rpx 0; color: var(--muted); font-size: var(--fs-base); transition: color var(--dur-fast) var(--ease-out); }
.seg-tab.is-active { color: var(--primary); font-weight: 700; }
.seg-tab.is-active::after {
  content: ""; position: absolute; bottom: -2rpx; left: 30%; right: 30%;
  height: 6rpx; border-radius: var(--r-pill); background: var(--primary);
}
.seg { display: flex; padding: 6rpx; background: var(--paper-2); border-radius: var(--r-pill); }
.seg-item { flex: 1; text-align: center; padding: 14rpx 0; border-radius: var(--r-pill); color: var(--muted); font-size: var(--fs-sm); font-weight: 600; transition: all var(--dur-normal) var(--ease-out); }
.seg-item.is-active { color: var(--accent-foreground); background: var(--paper); box-shadow: var(--shadow-sm); }

/* =============================================================
 * 开关（纯 WXSS，配 is-on 类）
 * ============================================================= */
.switch { position: relative; flex: 0 0 auto; width: 88rpx; height: 52rpx; border-radius: var(--r-pill); background: var(--line); transition: background var(--dur-normal) var(--ease-out); }
.switch::after {
  content: ""; position: absolute; top: 4rpx; left: 4rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #fff; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
  transition: transform var(--dur-normal) var(--ease-spring);
}
.switch.is-on { background: var(--primary); }
.switch.is-on::after { transform: translateX(36rpx); }

/* =============================================================
 * 列表（容器卡 + hairline 行）
 * ============================================================= */
.list { background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); overflow: hidden; }
.list-item { display: flex; align-items: center; gap: var(--s-2); min-height: 100rpx; padding: var(--s-2) var(--s-3); border-bottom: 1rpx solid var(--line-soft); }
.list-item:last-child { border-bottom: 0; }
.list-item--tap:active { background: var(--paper-2); }
.list-arrow { flex: 0 0 auto; color: var(--muted); font-size: var(--fs-xl); line-height: 1; }

/* =============================================================
 * 骨架屏（令牌化 + 流光）
 * ============================================================= */
.skeleton { position: relative; overflow: hidden; background: var(--paper-3); border-radius: var(--r-md); }
.skeleton::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.55) 50%, transparent 80%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s ease-in-out infinite;
}
@keyframes sk-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
@keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

.sk-line { height: 22rpx; margin: 14rpx 0; border-radius: 8rpx; background: var(--paper-3); display: block; }
.sk-block { height: 200rpx; border-radius: var(--r-lg); background: var(--paper-3); position: relative; overflow: hidden; }
.sk-circle { border-radius: 50%; }
.skeleton-wrap { padding: 32rpx; }
.sk-hero { margin-bottom: 32rpx; padding: 32rpx; background: var(--green-50); border-radius: var(--r-lg); }
.sk-grid { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.sk-card { flex: 1; height: 180rpx; background: var(--paper-3); border-radius: var(--r-lg); }
.sk-card.tall { height: auto; min-height: 260rpx; }
.sk-ring { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--paper-3); margin: 12rpx auto; }
.w60 { width: 60%; } .w40 { width: 40%; } .w80 { width: 80%; } .w50 { width: 50%; }

/* =============================================================
 * 浮动语音按钮(FAB) —— 主色 + 呼吸辉光（.fab--pulse 显式开启）
 * ============================================================= */
.fab {
  position: fixed; z-index: var(--z-fab);
  right: var(--s-4); bottom: calc(var(--s-8) + env(safe-area-inset-bottom));
  display: flex; align-items: center; justify-content: center;
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: var(--primary); color: #fff;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18), 0 10rpx 28rpx rgba(27, 122, 68, 0.32);
  transition: transform var(--dur-fast) var(--ease-spring);
}
.fab:active { transform: scale(0.92); }
.fab--pulse { animation: fab-glow 2.6s ease-in-out infinite; }
@keyframes fab-glow {
  0%, 100% { box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18), 0 10rpx 28rpx rgba(27, 122, 68, 0.32), 0 0 0 0 rgba(27, 122, 68, 0.28); }
  60% { box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18), 0 10rpx 28rpx rgba(27, 122, 68, 0.32), 0 0 0 22rpx rgba(27, 122, 68, 0); }
}

/* =============================================================
 * 空状态
 * ============================================================= */
.empty-state { padding: var(--s-12) var(--s-4); text-align: center; color: var(--muted); }
.empty-icon { display: block; margin: 0 auto var(--s-2); }
.empty-title { color: var(--ink-2); font-size: var(--fs-lg); font-weight: 700; }
.empty-desc { margin-top: 8rpx; font-size: var(--fs-sm); line-height: 1.6; }

/* =============================================================
 * Toast / 轻提示
 * ============================================================= */
.toast-mask { position: fixed; inset: 0; z-index: var(--z-toast); display: flex; align-items: center; justify-content: center; pointer-events: none; }
.toast-box {
  max-width: 70%; padding: var(--s-2) var(--s-3);
  background: rgba(16, 24, 19, 0.92); color: #fff;
  border-radius: var(--r-md); font-size: var(--fs-sm); text-align: center;
  box-shadow: var(--shadow-lg); animation: pop-in var(--dur) var(--ease-spring);
}

/* =============================================================
 * 主动洞察卡 —— 便签纸夹风（主色竖线）
 * ============================================================= */
.insight {
  position: relative;
  display: flex; gap: var(--s-2); padding: var(--s-3);
  background: var(--paper);
  border: 1rpx solid var(--ring); border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}
.insight::before {
  content: ""; position: absolute; left: 0; top: 16rpx; bottom: 16rpx;
  width: 6rpx; background: var(--primary); border-radius: 0 4rpx 4rpx 0;
}
.insight + .insight { margin-top: var(--s-2); }
.insight-body { flex: 1; }
.insight-title { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.insight-desc { margin-top: 6rpx; font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.55; }
.insight-accept { align-self: center; }

/* =============================================================
 * 时段皮肤(.skin-* 覆盖 --skin-*；背景柔光随时段过渡)
 * ============================================================= */
.skin-morning {
  --skin-accent: #2f8c53; --skin-glow: rgba(87, 193, 124, 0.14);
  --skin-ambient: rgba(87, 193, 124, 0.08); --skin-label: "早市";
}
.skin-noon {
  --skin-accent: var(--green-700); --skin-glow: rgba(27, 122, 68, 0.10);
  --skin-ambient: rgba(27, 122, 68, 0.06); --skin-label: "午市";
}
.skin-evening {
  --skin-accent: #bc8315; --skin-glow: rgba(217, 154, 38, 0.15);
  --skin-ambient: rgba(217, 154, 38, 0.09); --skin-label: "晚市";
}
.skin-ambient-layer {
  position: fixed; left: 0; right: 0; top: 0; height: 420rpx; z-index: 0;
  background: radial-gradient(120% 80% at 50% -10%, var(--skin-glow), transparent 70%);
  pointer-events: none; transition: background var(--dur-slow) var(--ease-out);
}

/* =============================================================
 * 表单字段（focus 品牌环 · 错误态）
 * ============================================================= */
.form-field { display: flex; flex-direction: column; gap: 10rpx; }
.form-label { display: flex; align-items: center; gap: 6rpx; font-size: 25rpx; font-weight: 600; color: var(--ink-2); }
.form-label .required { color: var(--tomato); }
.form-input, .form-picker {
  width: 100%; min-height: 84rpx; padding: 0 20rpx;
  background: var(--input-bg); border: 1rpx solid var(--line);
  border-radius: var(--r-md); font-size: 28rpx; color: var(--ink);
  transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
}
.form-picker { display: flex; align-items: center; }
.form-input:focus, .form-picker:focus { border-color: var(--green-500); background: var(--paper); box-shadow: var(--focus-ring); }
.form-input.has-error, .form-picker.has-error { border-color: var(--tomato); background: var(--tomato-soft); }
.form-error { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--tomato); }
.form-hint { display: block; font-size: 22rpx; color: var(--muted); }

/* =============================================================
 * 居中弹窗（Radix Dialog 语义：mask 遮罩 + 卡片弹入）
 * ============================================================= */
.dialog-mask {
  position: fixed; inset: 0; z-index: var(--z-drawer);
  display: flex; align-items: center; justify-content: center;
  background: rgba(10, 18, 13, 0.52);
  animation: fade-in var(--dur-fast) var(--ease-out);
}
.dialog {
  width: 620rpx; max-height: 82%; overflow-y: auto;
  padding: 40rpx 36rpx; background: var(--paper);
  border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  display: flex; flex-direction: column; gap: 24rpx;
  animation: pop-in var(--dur) var(--ease-spring);
}
.dialog-title { font-size: var(--fs-xl); font-weight: 700; color: var(--ink); text-align: center; }
.dialog-actions { display: flex; gap: var(--s-2); justify-content: flex-end; margin-top: var(--s-1); }
.dialog-actions .btn-primary, .dialog-actions .btn-secondary, .dialog-actions .btn-tomato, .dialog-actions .btn-outline { flex: 1; }

/* =============================================================
 * 底部弹层 Sheet（v5.0 新增 · 移动端首选弹层）
 * 用法：<view class="sheet-mask" wx:if="{{open}}" bindtap="close">
 *         <view class="sheet" catchtap>…</view></view>
 * ============================================================= */
.sheet-mask {
  position: fixed; inset: 0; z-index: var(--z-drawer);
  background: rgba(10, 18, 13, 0.52);
  display: flex; flex-direction: column; justify-content: flex-end;
  animation: fade-in var(--dur-fast) var(--ease-out);
}
.sheet {
  position: relative;
  max-height: 80%; overflow-y: auto;
  padding: 20rpx var(--s-4) calc(var(--s-6) + env(safe-area-inset-bottom));
  background: var(--paper);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  box-shadow: var(--shadow-lg);
  animation: sheet-up var(--dur-normal) var(--ease-expo);
}
.sheet::before {
  content: ""; position: absolute; top: 12rpx; left: 50%; margin-left: -30rpx;
  width: 60rpx; height: 8rpx; border-radius: var(--r-pill); background: var(--line);
}
.sheet-title { margin-top: 12rpx; font-size: var(--fs-lg); font-weight: 700; color: var(--ink); text-align: center; }

/* =============================================================
 * 角色头像
 * ============================================================= */
.avatar { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; font-weight: 800; }
.avatar--green { background: var(--green-700); }
.avatar--corn { background: var(--corn); color: #fff; }
.avatar--tomato { background: var(--tomato); }
.avatar--info { background: var(--info); }
.avatar--grape { background: var(--grape); }
.avatar--muted { background: var(--muted); }
.avatar--ring { box-shadow: 0 0 0 6rpx var(--accent); }

/* =============================================================
 * 入场编排（按页启用：.rise / .stagger--on）
 * ============================================================= */
.rise { animation: rise-in var(--dur-slow) var(--ease-expo) both; }
.stagger { opacity: 1; transform: none; animation: none; }
.stagger--on { opacity: 0; transform: translateY(18rpx); animation: rise-in var(--dur-slow) var(--ease-expo) forwards; }
.stagger--on:nth-child(1) { animation-delay: 0.05s; }
.stagger--on:nth-child(2) { animation-delay: 0.11s; }
.stagger--on:nth-child(3) { animation-delay: 0.17s; }
.stagger--on:nth-child(4) { animation-delay: 0.23s; }
.stagger--on:nth-child(5) { animation-delay: 0.29s; }
.stagger--on:nth-child(6) { animation-delay: 0.35s; }
/* 无障碍：reduce-motion 杀掉动画后，入场元素必须直接可见（否则 opacity:0 永久隐形） */
.reduce-motion .stagger--on, .reduce-motion .rise { opacity: 1; transform: none; animation: none; }
@keyframes rise-in { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }

/* =============================================================
 * 深色模式（绿黑 · 明度分层，非反相）
 * ============================================================= */
.ui-dark {
  --canvas: #0c110d;
  --paper: #182019;
  --paper-2: #121812;
  --paper-3: #0e130e;
  --ink: #e6ece7;
  --ink-2: #a6b2a9;
  --muted: #6e7870;
  --line: #293229;
  --line-soft: #1e2620;
  --ring: rgba(200, 230, 215, 0.10);
  --green-50: #122a1a;
  --green-100: #173c25;
  --green-200: #1d4a2e;
  --tomato-soft: #3a1f1a;
  --corn-soft: #382c13;
  --info-soft: #182640;
  --grape-soft: #251d3c;
  --hero-grad: linear-gradient(168deg, #1d6b3c 0%, #175532 46%, #103a22 100%);
  --hero-dot: rgba(255, 255, 255, 0.07);
  --hero-glow: 0 10rpx 30rpx rgba(0, 0, 0, 0.45);
  --input-bg: #10160f;
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.35), 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
  --shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.4), 0 14rpx 34rpx rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 8rpx 20rpx rgba(0, 0, 0, 0.45), 0 24rpx 60rpx rgba(0, 0, 0, 0.6);
  background:
    radial-gradient(120% 46% at 50% -6%, var(--skin-ambient), transparent 70%),
    var(--canvas);
  color: var(--ink);
}

/* =============================================================
 * 关键帧
 * ============================================================= */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes pop-in { 0% { opacity: 0; transform: scale(0.9) translateY(8rpx); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes sheet-up { from { transform: translateY(30%); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }
@keyframes sheen { 0% { left: -45%; } 55%, 100% { left: 115%; } }
@keyframes breathe { 0%, 100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.14); opacity: 1; } }
@keyframes float-y { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
@keyframes count-pulse { 0% { transform: scale(1); } 40% { transform: scale(1.06); } 100% { transform: scale(1); } }

/* =============================================================
 * 动效偏好降级（无障碍）：page 节点加 class="reduce-motion"
 * ============================================================= */
.reduce-motion view, .reduce-motion view::before, .reduce-motion view::after,
.reduce-motion text, .reduce-motion text::before, .reduce-motion text::after,
.reduce-motion button, .reduce-motion image, .reduce-motion input,
.reduce-motion textarea, .reduce-motion scroll-view, .reduce-motion swiper,
.reduce-motion canvas, .reduce-motion cover-view, .reduce-motion cover-image {
  animation: none !important; transition: none !important;
}

/* =============================================================
 * v5.1 扩展组件层（ui- 前缀命名，避免与页面级类名冲突）
 * 对照 shadcn：Accordion / Checkbox / RadioGroup / Stepper /
 * Slider 引导 / Table / Timeline / Alert(滚动公告) / Result / Grid
 * ============================================================= */

/* ---------- 步骤条 ---------- */
.ui-steps { display: flex; }
.ui-step { flex: 1; text-align: center; position: relative; color: var(--muted); font-size: var(--fs-xs); }
.ui-step + .ui-step::before { content: ""; position: absolute; top: 20rpx; left: -50%; right: 50%; height: 2rpx; background: var(--line); }
.ui-step-dot { position: relative; z-index: 1; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--paper-3); color: var(--muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 8rpx; font-size: var(--fs-xs); font-weight: 700; font-family: var(--font-num); }
.ui-step.is-done { color: var(--green-700); }
.ui-step.is-done .ui-step-dot { background: var(--green-100); color: var(--green-700); }
.ui-step.is-done + .ui-step::before { background: var(--green-300); }
.ui-step.is-current { color: var(--ink); font-weight: 700; }
.ui-step.is-current .ui-step-dot { background: var(--primary); color: var(--primary-foreground); box-shadow: var(--glow-primary); }

/* ---------- 折叠面板 Accordion ---------- */
.ui-acc { background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); padding: 0 var(--s-3); }
.ui-acc-item { border-bottom: 1rpx solid var(--line-soft); }
.ui-acc-item:last-child { border-bottom: 0; }
.ui-acc-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 24rpx 0; font-size: var(--fs-base); font-weight: 600; color: var(--ink); }
.ui-acc-arrow { color: var(--muted); font-size: var(--fs-sm); transition: transform var(--dur-normal) var(--ease-out); }
.ui-acc-item.is-open .ui-acc-arrow { transform: rotate(90deg); }
.ui-acc-body { overflow: hidden; max-height: 0; transition: max-height var(--dur-normal) var(--ease-out); font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.6; }
.ui-acc-item.is-open .ui-acc-body { max-height: 480rpx; }
.ui-acc-inner { padding: 0 4rpx 24rpx; }

/* ---------- 复选框 / 单选 ---------- */
.ui-check, .ui-radio { position: relative; flex: 0 0 auto; width: 40rpx; height: 40rpx; background: var(--paper); border: 2rpx solid var(--line); transition: all var(--dur-fast) var(--ease-out); }
.ui-check { border-radius: var(--r-sm); }
.ui-radio { border-radius: 50%; }
.ui-check.is-on { background: var(--primary); border-color: var(--primary); }
.ui-check.is-on::after { content: ""; position: absolute; left: 11rpx; top: 5rpx; width: 10rpx; height: 17rpx; border-right: 3rpx solid #fff; border-bottom: 3rpx solid #fff; transform: rotate(45deg); }
.ui-radio.is-on { border-color: var(--primary); }
.ui-radio.is-on::after { content: ""; position: absolute; inset: 8rpx; border-radius: 50%; background: var(--primary); }
.ui-check-row, .ui-radio-row { display: flex; align-items: center; gap: var(--s-2); padding: 20rpx 0; font-size: var(--fs-base); color: var(--ink); }
.ui-check-row:active, .ui-radio-row:active { opacity: 0.7; }

/* ---------- 数量步进器 ---------- */
.ui-stepper { display: inline-flex; align-items: center; padding: 6rpx; background: var(--paper-2); border-radius: var(--r-pill); }
.ui-stepper-btn { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--paper); color: var(--ink-2); display: flex; align-items: center; justify-content: center; font-size: var(--fs-lg); font-weight: 700; box-shadow: var(--shadow-sm); transition: transform var(--dur-fast) var(--ease-spring); }
.ui-stepper-btn:active { transform: scale(0.88); }
.ui-stepper-btn.is-disabled { opacity: 0.35; pointer-events: none; }
.ui-stepper-num { min-width: 84rpx; text-align: center; font-family: var(--font-num); font-weight: 700; font-size: var(--fs-lg); font-variant-numeric: tabular-nums; }

/* ---------- 价签排版（签名元素 · 配 .num 家族） ---------- */
.ui-price { display: inline-flex; align-items: baseline; line-height: 1; color: var(--ink); font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.ui-price-sym { font-size: var(--fs-sm); font-weight: 700; margin-right: 2rpx; }
.ui-price-int { font-size: var(--fs-2xl); font-weight: 800; letter-spacing: -1rpx; }
.ui-price-unit { margin-left: 6rpx; color: var(--muted); font-size: var(--fs-xs); font-family: var(--font-body); font-weight: 400; }
.ui-price--tomato { color: var(--tomato); }
.ui-price--lg .ui-price-int { font-size: var(--fs-3xl); }

/* ---------- 搜索框 ---------- */
.ui-search { display: flex; align-items: center; gap: 12rpx; min-height: 72rpx; padding: 0 24rpx; background: var(--paper-2); border: 1rpx solid transparent; border-radius: var(--r-pill); transition: all var(--dur-fast) var(--ease-out); }
.ui-search:focus-within { background: var(--paper); border-color: var(--green-500); box-shadow: var(--focus-ring); }
.ui-search-glyph { color: var(--muted); font-size: var(--fs-base); }
.ui-search-input { flex: 1; min-height: 0; height: 72rpx; font-size: var(--fs-sm); color: var(--ink); background: transparent; }
.ui-search-cancel { flex: 0 0 auto; color: var(--primary); font-size: var(--fs-sm); font-weight: 600; }

/* ---------- 滚动公告 ---------- */
.ui-notice { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 20rpx; background: var(--corn-soft); border-radius: var(--r-md); color: var(--corn-ink); }
.ui-notice-badge { flex: 0 0 auto; padding: 2rpx 10rpx; background: var(--corn); color: #fff; border-radius: var(--r-sm); font-size: var(--fs-xs); font-weight: 700; }
.ui-notice-viewport { flex: 1; height: 36rpx; overflow: hidden; }
.ui-notice-text { display: inline-block; white-space: nowrap; line-height: 36rpx; font-size: var(--fs-sm); animation: ui-marquee 12s linear infinite; }
@keyframes ui-marquee { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }

/* ---------- 时间线 ---------- */
.ui-timeline { padding-left: 36rpx; }
.ui-tl-item { position: relative; padding-bottom: 32rpx; }
.ui-tl-item::before { content: ""; position: absolute; left: -29rpx; top: 20rpx; bottom: -2rpx; width: 2rpx; background: var(--line); }
.ui-tl-item:last-child::before { content: none; }
.ui-tl-dot { position: absolute; left: -36rpx; top: 6rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--line); }
.ui-tl-item.is-hi .ui-tl-dot { background: var(--primary); box-shadow: 0 0 0 6rpx var(--accent); }
.ui-tl-time { font-size: var(--fs-xs); color: var(--muted); font-family: var(--font-num); }
.ui-tl-title { margin-top: 4rpx; font-size: var(--fs-base); font-weight: 600; color: var(--ink); }
.ui-tl-desc { margin-top: 4rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.5; }

/* ---------- 简易表格 ---------- */
.ui-table { background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); overflow: hidden; }
.ui-tr { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--line-soft); font-size: var(--fs-sm); color: var(--ink-2); }
.ui-tr:last-child { border-bottom: 0; }
.ui-tr.ui-th { background: var(--paper-2); color: var(--muted); font-weight: 600; }
.ui-tr > view, .ui-tr > text { flex: 1; min-width: 0; }
.ui-tr .is-num { flex: 0 0 30%; text-align: right; font-family: var(--font-num); font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.ui-tr.ui-th .is-num { color: var(--muted); font-weight: 600; }
.ui-tr .is-red { color: var(--tomato); }

/* ---------- 键值对 ---------- */
.ui-kv { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; padding: 14rpx 0; font-size: var(--fs-sm); }
.ui-kv-key { flex: 0 0 auto; color: var(--muted); }
.ui-kv-val { color: var(--ink); text-align: right; word-break: break-all; }

/* ---------- 结果页 ---------- */
.ui-result { display: flex; flex-direction: column; align-items: center; text-align: center; padding: var(--s-8) var(--s-4); }
.ui-result-icon { width: 140rpx; height: 140rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 64rpx; background: var(--green-50); color: var(--green-700); margin-bottom: var(--s-3); }
.ui-result-icon.is-tomato { background: var(--tomato-soft); color: var(--tomato); }
.ui-result-title { font-size: var(--fs-xl); font-weight: 700; color: var(--ink); }
.ui-result-desc { margin-top: 10rpx; font-size: var(--fs-sm); color: var(--muted); line-height: 1.6; }
.ui-result-actions { margin-top: var(--s-4); width: 100%; }

/* ---------- 九宫格入口 ---------- */
.ui-quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rpx; background: var(--line-soft); border: 1rpx solid var(--ring); border-radius: var(--r-lg); overflow: hidden; }
.ui-quick-cell { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 28rpx 0; background: var(--paper); font-size: var(--fs-xs); color: var(--ink-2); }
.ui-quick-cell:active { background: var(--paper-2); }
.ui-quick-glyph { font-size: 44rpx; line-height: 1; }

/* ---------- 加载 ---------- */
.ui-spinner { width: 48rpx; height: 48rpx; border-radius: 50%; border: 4rpx solid var(--green-100); border-top-color: var(--primary); animation: spin 0.9s linear infinite; }
.ui-dots { display: inline-flex; gap: 8rpx; }
.ui-dots > view { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--muted); animation: ui-dots-bounce 1.2s ease-in-out infinite; }
.ui-dots > view:nth-child(2) { animation-delay: 0.15s; }
.ui-dots > view:nth-child(3) { animation-delay: 0.3s; }
@keyframes ui-dots-bounce { 0%, 80%, 100% { transform: translateY(0); opacity: 0.5; } 40% { transform: translateY(-8rpx); opacity: 1; } }

/* ---------- 红点徽章 / 渐变文字 / 带字分隔线 ---------- */
.badge--dot { min-width: 14rpx; width: 14rpx; height: 14rpx; padding: 0; background: var(--tomato); }
.badge--dot.is-pulse { animation: ui-dot-pulse 2s ease-out infinite; }
@keyframes ui-dot-pulse { 0% { box-shadow: 0 0 0 0 rgba(217, 58, 43, 0.35); } 70% { box-shadow: 0 0 0 12rpx rgba(217, 58, 43, 0); } 100% { box-shadow: 0 0 0 0 rgba(217, 58, 43, 0); } }
.grad-text { color: var(--green-700); background: linear-gradient(135deg, var(--green-500), var(--green-800)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.divider--text { display: flex; align-items: center; gap: 16rpx; color: var(--muted); font-size: var(--fs-xs); margin: var(--s-2) 0; }
.divider--text::before, .divider--text::after { content: ""; flex: 1; height: 1rpx; background: var(--line); }

/* ---------- 氛围 · 网格背景（Aceternity grid，市井布纹版） ----------
 * 用法：<view class="card bg-grid card--pad"> 或叠加在任意容器上。
 * 可用 --grid-line 覆网格线色。
 */
.bg-grid {
  background-image:
    linear-gradient(var(--grid-line, rgba(23, 32, 26, 0.05)) 1rpx, transparent 1rpx),
    linear-gradient(90deg, var(--grid-line, rgba(23, 32, 26, 0.05)) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
}
.ui-dark .bg-grid { --grid-line: rgba(200, 230, 215, 0.06); }

/* ---------- 氛围 · 聚光卡（Aceternity spotlight，一角柔光） ----------
 * 用法：<view class="card card--spotlight" style="--spot: rgba(217,154,38,.16)">
 * --spot 缺省用当前时段皮肤光色。
 */
.card--spotlight { position: relative; overflow: hidden; }
.card--spotlight::before {
  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background: radial-gradient(70% 90% at 88% 0%, var(--spot, var(--skin-glow)), transparent 62%);
}
.card--spotlight > view, .card--spotlight > text, .card--spotlight > button { position: relative; z-index: 1; }

/* =============================================================
 * 向后兼容别名层（旧页面/组件引用的旧令牌名，勿删）
 * ============================================================= */
page {
  --amber: var(--corn);
  --amber-soft: var(--corn-soft);
  --red: var(--tomato);
  --red-soft: var(--tomato-soft);
  --blue: var(--info);
  --radius-xl: var(--r-xl);
  --radius-lg: var(--r-lg);
  --radius-md: var(--r-md);
  --radius-sm: var(--r-sm);
  /* v5.0 补漏：catalog/supplier/inventory/staff 页面曾引用但从未定义的变量 */
  --paper-1: var(--paper-2);
  --surface: var(--paper);
  --surface-muted: var(--paper-2);
  --danger-600: var(--tomato-600);
}
.tag-amber { color: var(--corn-ink); background: var(--corn-soft); }
.tag-red { color: var(--tomato-ink); background: var(--tomato-soft); }
