<!-- 记账页 · 降低操作门槛，突出主任务 (v2.2 生鲜元气) -->
<view class="page-shell voice-page skin-{{skin}}">
  <view class="page-hero voice-hero">
    <view class="voice-hero-top">
      <view>
        <text class="eyebrow">语音记账</text>
        <text class="hero-title">今天发生了什么？</text>
      </view>
      <mascot size="md" mood="{{state==='listening' ? 'think' : 'idle'}}" />
    </view>
    <text class="hero-desc">按住说话，或直接打字。自动整理成商品、数量和金额。</text>
    <view class="today-chip"><text class="chip-number">{{todayCount}}</text><text>今日已记</text></view>
  </view>

  <view class="mode-switch">
    <view class="mode-option {{mode === 'voice' ? 'active' : ''}}" bindtap="switchToVoice">
      <icon name="mic" size="34" color="{{mode==='voice' ? 'var(--green-950)' : 'var(--muted)'}}" /><text>语音记账</text>
    </view>
    <view class="mode-option {{mode === 'text' ? 'active' : ''}}" bindtap="switchToText">
      <icon name="leaf" size="34" color="{{mode==='text' ? 'var(--green-950)' : 'var(--muted)'}}" /><text>文字记账</text>
    </view>
  </view>

  <block wx:if="{{mode === 'voice'}}">
    <view class="voice-stage">
      <!-- 声波纹（录音态跳动） -->
      <view class="wave-wrap {{state==='listening' ? 'on' : ''}}">
        <view class="wave-bar" wx:for="{{waveBars}}" wx:key="*this" style="--i:{{index}}"></view>
      </view>
      <view class="voice-rings"><voice-button state="{{state}}" bind:start="onStart" bind:end="onEnd" bind:cancel="onCancel" /></view>
      <text class="stage-tip" wx:if="{{state === 'idle'}}">例如：“今天进了白菜50斤，三毛一斤”</text>
      <text class="stage-tip active" wx:elif="{{state === 'listening'}}">正在记录，松开后自动识别</text>
      <text class="stage-tip active" wx:elif="{{state === 'uploading'}}">上传中 {{uploadProgress}}%</text>
      <text class="stage-tip active" wx:elif="{{state === 'respeaking'}}">正在重说，说完点纠错卡上的按钮</text>
      <text class="stage-tip active" wx:elif="{{state === 'pending_retry'}}">网络异常，录音已暂存</text>
      <text class="stage-tip active" wx:else>正在把你的话整理成账目</text>
      <!-- 上传进度条：仅在上传中且未到 100% 时显示 -->
      <view class="upload-progress" wx:if="{{state === 'uploading' && uploadProgress > 0 && uploadProgress < 100}}">
        <view class="upload-progress-bar" style="width:{{uploadProgress}}%"></view>
      </view>
      <!-- 方言切换入口：与后端 Form(dialect) 对齐 -->
      <view class="dialect-chip" bindtap="chooseDialect" wx:if="{{state === 'idle'}}">方言：{{dialectLabel}}</view>
    </view>
  </block>

  <block wx:if="{{mode === 'text'}}">
    <view class="text-panel">
      <view class="input-head"><text>输入一笔经营流水</text><text class="input-count">{{textInput.length || 0}}/200</text></view>
      <textarea class="text-input" value="{{textInput}}" placeholder="例如：卖了西瓜20斤，两块钱一斤" bindinput="onTextInput" maxlength="200" auto-height="{{true}}" />
      <button class="btn-primary submit-text" bindtap="submitText" disabled="{{!textInput}}">识别并整理</button>
    </view>
  </block>

  <!-- 流式字幕（逐字打印） -->
  <view class="subtitle" wx:if="{{streamingText}}">
    <mascot size="sm" mood="think" />
    <text class="subtitle-text">{{streamingText}}<text class="caret">▍</text></text>
  </view>

  <view class="asr-card" wx:if="{{asrText}}">
    <view class="asr-head"><text class="asr-dot"></text><text>识别原文</text></view>
    <text class="asr-text">“{{asrText}}”</text>
  </view>

  <!-- 多意图：汇总条（逐条确认进度 + 一键全部确认） -->
  <view class="multi-bar" wx:if="{{parsedEvents && parsedEvents.length > 1 && showRecords}}">
    <view class="multi-copy">
      <text class="multi-title">一次听出 {{parsedEvents.length}} 笔</text>
      <text class="multi-done">已确认 {{confirmedCount}}/{{parsedEvents.length}}</text>
    </view>
    <view class="multi-btn {{confirmedCount >= parsedEvents.length ? 'done' : ''}}" bindtap="confirmAll">
      {{confirmedCount >= parsedEvents.length ? '都记好了' : '一键全部确认'}}
    </view>
  </view>

  <!-- 后端 warning（如部分内容没听清，整体仍可确认） -->
  <view class="parse-warning" wx:if="{{parseWarning}}"><text>{{parseWarning}}</text></view>

  <!-- 多意图：逐笔确认卡 -->
  <block wx:if="{{parsedEvents && parsedEvents.length > 1 && showRecords}}">
    <view class="multi-item {{item._confirmed ? 'done' : ''}}" wx:for="{{parsedEvents}}" wx:key="_key">
      <view class="multi-item-head">
        <text class="multi-item-tag {{item._confirmed ? 'ok' : ''}}">{{item._confirmed ? '已入账' : '第' + (index + 1) + '笔'}}</text>
      </view>
      <record-card record="{{item}}" show-actions="{{!item._confirmed}}" bind:confirm="confirmRecord" bind:correct="correctAndConfirm" />
    </view>
  </block>

  <!-- 单条：渲染行为与旧版一致 -->
  <record-card wx:if="{{parsed && !(parsedEvents && parsedEvents.length > 1)}}" record="{{parsed}}" show-actions="{{showRecords}}" bind:confirm="confirmRecord" bind:correct="correctAndConfirm" />

  <!-- 页内纠错卡：商品 chips 点选 + 数字键盘 + 重说这一项（替代串行弹窗） -->
  <view class="cp" wx:if="{{correction}}">
    <view class="cp-head">
      <view>
        <text class="cp-eyebrow">CORRECTION</text>
        <text class="cp-title">改一改这笔账</text>
      </view>
      <text class="cp-close" bindtap="closeCorrection">收起</text>
    </view>

    <view class="cp-field">
      <text class="cp-label">商品（点一下就选好）</text>
      <view class="cp-chips" wx:if="{{correction.candidates.length > 0}}">
        <view class="cp-chip {{correction.product === item ? 'active' : ''}}" wx:for="{{correction.candidates}}" wx:key="*this" data-name="{{item}}" bindtap="pickProductChip">{{item}}</view>
      </view>
      <input class="cp-input cp-input-text" type="text" value="{{correction.product}}" placeholder="列表没有？在这里改" bindinput="onCorrectProduct" />
    </view>

    <view class="cp-grid">
      <view class="cp-field">
        <text class="cp-label">数量</text>
        <view class="cp-input-wrap">
          <input class="cp-input" type="digit" value="{{correction.quantity}}" placeholder="0" bindinput="onCorrectQuantity" />
          <text class="cp-unit">{{correction.unit || '斤'}}</text>
        </view>
      </view>
      <view class="cp-field">
        <text class="cp-label">金额</text>
        <view class="cp-input-wrap">
          <input class="cp-input" type="digit" value="{{correction.amount}}" placeholder="0" bindinput="onCorrectAmount" />
          <text class="cp-unit">元</text>
        </view>
      </view>
    </view>

    <view class="cp-respeak {{state === 'respeaking' ? 'on' : ''}}" bindtap="toggleRespeak">
      <icon name="mic" size="30" color="{{state === 'respeaking' ? '#c93a30' : 'var(--green-700)'}}" />
      <text>{{state === 'respeaking' ? '正在说…说完点这里' : '重说这一项'}}</text>
    </view>

    <button class="btn-primary cp-submit" bindtap="submitCorrection" disabled="{{correction.submitting}}">保存并确认</button>
  </view>

  <view class="error-panel" wx:if="{{state === 'error'}}">
    <icon name="bulb" size="40" color="var(--red)" />
    <view class="error-copy"><text class="error-title">这次没有听清</text><text class="error-desc">换个安静的地方，或改用文字输入。</text></view>
    <button class="retry-btn" bindtap="sayAgain">重试</button>
  </view>

  <!-- 暂存重传面板：上传失败且已暂存时显示 -->
  <view class="error-panel pending-panel" wx:if="{{state === 'pending_retry'}}">
    <icon name="bulb" size="40" color="var(--corn)" />
    <view class="error-copy"><text class="error-title">网络异常，录音已暂存</text><text class="error-desc">连上网后点"重新上传"继续，或重新录一条。</text></view>
    <button class="retry-btn" bindtap="retryUpload">重新上传</button>
  </view>

  <view class="section-head" wx:if="{{recentLogs.length > 0}}"><text class="section-title">最近说过</text><text class="section-caption">可撤销已记账</text></view>
  <view class="recent-list" wx:if="{{recentLogs.length > 0}}">
    <view wx:for="{{recentLogs}}" wx:key="id" class="recent-item">
      <text class="recent-index">0{{index + 1}}</text>
      <text class="recent-text">{{item.asr_text}}</text>
      <view class="recent-status">
        <text class="recent-tag {{item.status === 'confirmed' ? 'tag-green' : item.status === 'voided' ? 'tag-red' : 'tag-amber'}}">{{item.status === 'confirmed' ? '已记账' : item.status === 'voided' ? '已撤销' : '待确认'}}</text>
        <text class="void-btn" wx:if="{{item.status === 'confirmed'}}" bindtap="voidRecord" data-id="{{item.id}}">撤销</text>
      </view>
    </view>
  </view>
</view>
