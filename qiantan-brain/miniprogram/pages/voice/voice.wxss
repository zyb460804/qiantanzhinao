.voice-page { padding-top: 22rpx; }
.voice-hero { min-height: 270rpx; }
.voice-hero-top { position: relative; z-index: 2; display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.today-chip { position: absolute; z-index: 2; right: 28rpx; bottom: 24rpx; display: flex; align-items: baseline; gap: 8rpx; padding: 10rpx 16rpx; color: rgba(255,255,255,.72); background: rgba(255,255,255,.1); border-radius: 999rpx; font-size: 21rpx; }
.chip-number { font-family: var(--font-num); font-size: 31rpx; font-weight: 800; color: var(--corn); }

.mode-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-top: 22rpx; padding: 8rpx; background: var(--paper-2); border-radius: 22rpx; }
.mode-option { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 78rpx; color: var(--muted); border-radius: 17rpx; font-size: 25rpx; font-weight: 650; }
.mode-option.active { color: var(--green-950); background: var(--paper); box-shadow: 0 6rpx 16rpx rgba(16, 32, 24,.08); }

.voice-stage { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 480rpx; }

/* 声波纹 */
.wave-wrap { display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 90rpx; margin-bottom: 6rpx; opacity: .25; transition: opacity var(--dur-fast); }
.wave-wrap.on { opacity: 1; }
.wave-bar { width: 10rpx; height: 18rpx; border-radius: 999rpx; background: var(--green-600); }
.wave-wrap.on .wave-bar { animation: wave 1.1s var(--ease-spring) infinite; animation-delay: calc(var(--i) * 70ms); }
@keyframes wave { 0%,100% { height: 16rpx; } 50% { height: 78rpx; } }

.voice-rings { display: flex; align-items: center; justify-content: center; width: 380rpx; height: 380rpx; background: radial-gradient(circle, rgba(31,114,85,.11) 0, rgba(31,114,85,.06) 52%, transparent 53%); border-radius: 50%; }
.stage-tip { max-width: 580rpx; margin-top: 14rpx; color: var(--muted); text-align: center; font-size: 24rpx; }
.stage-tip.active { color: var(--green-700); font-weight: 650; }

/* 流式字幕 */
.subtitle { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; padding: 22rpx 24rpx; background: var(--green-50); border: 2rpx solid var(--green-200); border-radius: var(--radius-lg); }
.subtitle-text { flex: 1; color: var(--ink); font-size: 27rpx; line-height: 1.55; }
.caret { color: var(--corn); animation: blink 1s step-end infinite; }
@keyframes blink { 50% { opacity: 0; } }

.text-panel { margin-top: 22rpx; padding: 28rpx; background: var(--paper); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.input-head { display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 700; }
.input-count { color: var(--muted); font-size: 21rpx; font-weight: 500; }
.text-input { width: 100%; min-height: 210rpx; margin: 22rpx 0; padding: 22rpx; color: var(--ink); background: var(--paper-2); border: 2rpx solid transparent; border-radius: 18rpx; font-size: 29rpx; line-height: 1.65; }
.submit-text[disabled] { opacity: .45; }

.asr-card { margin-top: 12rpx; padding: 25rpx 28rpx; background: #eef4f1; border-left: 7rpx solid var(--green-700); border-radius: 8rpx var(--radius-lg) var(--radius-lg) 8rpx; }
.asr-head { display: flex; align-items: center; gap: 10rpx; color: var(--green-700); font-size: 22rpx; font-weight: 700; }
.asr-dot { width: 10rpx; height: 10rpx; background: var(--green-700); border-radius: 50%; }
.asr-text { display: block; margin-top: 11rpx; color: var(--ink); font-size: 29rpx; line-height: 1.65; }

.error-panel { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; padding: 22rpx; background: var(--red-soft); border-radius: var(--radius-lg); }
.error-copy { flex: 1; }
.error-title, .error-desc { display: block; }
.error-title { color: #c93a30; font-weight: 700; }
.error-desc { margin-top: 3rpx; color: #a86661; font-size: 21rpx; }
.retry-btn { padding: 14rpx 20rpx; color: #c93a30; background: rgba(255,255,255,.58); border-radius: 14rpx; font-size: 23rpx; font-weight: 700; }

.recent-list { overflow: hidden; background: var(--paper); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.recent-item { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.recent-item:last-child { border-bottom: 0; }
.recent-index { color: var(--green-700); font-family: monospace; font-size: 22rpx; font-weight: 800; }
.recent-text { flex: 1; color: var(--ink-2); font-size: 24rpx; }
.recent-status { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.recent-tag { display: inline-flex; align-items: center; min-height: 36rpx; padding: 0 12rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 650; }
.void-btn { color: var(--red); font-size: 22rpx; font-weight: 650; padding: 8rpx 16rpx; background: var(--red-soft); border-radius: 12rpx; }

.reduce-motion .wave-bar,
.reduce-motion .caret { animation: none !important; }

/* 上传进度条（弱网反馈） */
.upload-progress { width: 580rpx; max-width: 80%; height: 8rpx; margin-top: 18rpx; background: var(--paper-2); border-radius: 999rpx; overflow: hidden; }
.upload-progress-bar { height: 100%; background: linear-gradient(90deg, var(--green-600), var(--corn)); border-radius: 999rpx; transition: width var(--dur-fast); }

/* 方言切换入口 */
.dialect-chip { margin-top: 18rpx; padding: 10rpx 22rpx; color: var(--green-700); background: var(--green-50); border: 2rpx solid var(--green-200); border-radius: 999rpx; font-size: 22rpx; font-weight: 650; }
.dialect-chip:active { opacity: .7; }

/* 暂存重传面板（沿用 error-panel 视觉，但用警示色） */
.pending-panel { background: #fff7e6; }
.pending-panel .error-title { color: #b87b1a; }
.pending-panel .error-desc { color: #977043; }
.pending-panel .retry-btn { color: #b87b1a; }

/* ── 多意图（v3.2）：汇总条 + 逐笔卡片 ── */
.multi-bar { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 22rpx 24rpx; background: var(--paper); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.multi-copy { flex: 1; min-width: 0; }
.multi-title, .multi-done { display: block; }
.multi-title { color: var(--ink); font-size: 27rpx; font-weight: 740; }
.multi-done { margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.multi-btn { flex-shrink: 0; padding: 16rpx 22rpx; color: #fff; background: var(--green-800); border-radius: 16rpx; font-size: 23rpx; font-weight: 720; }
.multi-btn.done { color: var(--green-700); background: var(--green-50); }
.multi-btn:active { opacity: .8; }
.multi-item { margin-top: 18rpx; }
.multi-item.done { opacity: .72; }
.multi-item-head { display: flex; align-items: center; }
.multi-item-tag { display: inline-flex; align-items: center; min-height: 38rpx; padding: 0 16rpx; margin-left: 8rpx; color: var(--green-700); background: var(--green-50); border: 2rpx solid var(--green-200); border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.multi-item-tag.ok { color: #fff; background: var(--green-700); border-color: var(--green-700); }

/* 后端 warning 提示条（玉米色警示，不阻断操作） */
.parse-warning { margin-top: 16rpx; padding: 16rpx 22rpx; color: var(--corn-ink); background: var(--corn-soft); border-radius: var(--radius-lg); font-size: 23rpx; line-height: 1.5; }

/* ── 页内纠错卡（v3.2，低置信兜底主路径）── */
.cp { margin-top: 20rpx; padding: 28rpx; background: var(--paper); border: 2rpx dashed var(--green-300); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
.cp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.cp-eyebrow, .cp-title { display: block; }
.cp-eyebrow { color: var(--muted); font-size: 17rpx; letter-spacing: 2rpx; }
.cp-title { margin-top: 4rpx; color: var(--ink); font-size: 30rpx; font-weight: 760; }
.cp-close { flex-shrink: 0; padding: 8rpx 18rpx; color: var(--muted); background: var(--paper-2); border-radius: 999rpx; font-size: 21rpx; }
.cp-close:active { opacity: .7; }
.cp-field { margin-top: 22rpx; }
.cp-grid .cp-field { margin-top: 18rpx; }
.cp-label { display: block; margin-bottom: 12rpx; color: var(--ink-2); font-size: 22rpx; font-weight: 700; }
.cp-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cp-chip { padding: 12rpx 24rpx; color: var(--green-800); background: var(--green-50); border: 2rpx solid var(--green-200); border-radius: 999rpx; font-size: 24rpx; font-weight: 650; }
.cp-chip.active { color: #fff; background: var(--green-700); border-color: var(--green-700); }
.cp-chip:active { opacity: .7; }
.cp-input { width: 100%; min-height: 78rpx; padding: 0 20rpx; box-sizing: border-box; color: var(--ink); background: var(--paper-2); border: 2rpx solid transparent; border-radius: 16rpx; font-size: 27rpx; }
.cp-input-text { margin-top: 14rpx; }
.cp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.cp-input-wrap { display: flex; align-items: center; gap: 12rpx; padding-right: 18rpx; background: var(--paper-2); border-radius: 16rpx; }
.cp-input-wrap .cp-input { flex: 1; min-width: 0; background: transparent; }
.cp-unit { flex-shrink: 0; color: var(--muted); font-size: 22rpx; }
.cp-respeak { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 22rpx; min-height: 72rpx; color: var(--green-700); background: var(--green-50); border: 2rpx dashed var(--green-300); border-radius: 16rpx; font-size: 24rpx; font-weight: 700; }
.cp-respeak.on { color: #c93a30; background: var(--red-soft); border-color: #c93a30; animation: cp-pulse 1.1s var(--ease-spring) infinite; }
.cp-respeak:active { opacity: .75; }
@keyframes cp-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
.reduce-motion .cp-respeak.on { animation: none !important; }
.cp-submit { margin-top: 22rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; font-size: 27rpx; font-weight: 720; }
.cp-submit[disabled] { opacity: .55; }
