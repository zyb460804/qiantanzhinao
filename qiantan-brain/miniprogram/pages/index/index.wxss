/* 经营台 · v4.2 令牌化重排版
 * 只保留 wxml 实际用到的类；字号/字重/圆角全部走 app.wxss 令牌
 * （字号 20/23/28/32/38/46/84，字重 600/700/800）。
 */
.index-page { padding-top: var(--s-3); padding-bottom: 160rpx; }

/* ── 缓存降级提示（此前 wxml 挂了类但从未定义样式）── */
.stale-banner { margin-bottom: var(--s-2); padding: 16rpx 22rpx; color: var(--corn-ink); background: var(--corn-soft); border-radius: var(--r-md); font-size: var(--fs-sm); text-align: center; }

/* ── Hero：问候降 eyebrow，毛利金额升主视觉 ── */
.home-hero { padding: 36rpx 32rpx 32rpx; position: relative; overflow: hidden; }
.hero-topline { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.home-eyebrow { margin-bottom: 0; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.skin-seg { display: flex; flex: 0 0 auto; padding: 6rpx; background: rgba(255,255,255,.12); border-radius: var(--r-pill); }
.skin-opt { padding: 8rpx 16rpx; color: rgba(255,255,255,.66); font-size: var(--fs-xs); font-weight: 600; border-radius: var(--r-pill); transition: all var(--dur-fast) var(--ease-spring); }
.skin-opt.on { color: var(--green-950); background: var(--paper); box-shadow: 0 4rpx 12rpx rgba(16, 32, 24,.14); }
.home-amount-row { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; }
.home-amount-col { min-width: 0; }
.home-amount { display: block; font-family: var(--font-num); font-size: var(--fs-hero); font-weight: 800; letter-spacing: -2rpx; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
/* 较昨日趋势胶囊：摊主第一问题是"比昨天怎么样" */
.home-trend { display: inline-flex; align-items: center; margin-top: 14rpx; padding: 6rpx 18rpx; border-radius: var(--r-pill); background: rgba(255,255,255,.12); color: rgba(255,255,255,.85); font-size: var(--fs-xs); font-weight: 600; font-variant-numeric: tabular-nums; }
.home-trend.up { color: #7ee8a0; background: rgba(126, 232, 160, .12); }
.home-trend.down { color: #ffb088; background: rgba(255, 176, 136, .12); }
.home-amount-label { position: relative; z-index: 2; display: block; margin-top: 14rpx; color: rgba(255,255,255,.72); font-size: var(--fs-sm); }
.home-amount-note { position: relative; z-index: 2; display: block; margin-top: 4rpx; color: rgba(255,255,255,.48); font-size: var(--fs-xs, 22rpx); }
.weather-pill { position: relative; z-index: 2; display: flex; align-items: center; gap: 10rpx; padding: 12rpx 18rpx; color: rgba(255,255,255,.86); background: rgba(255,255,255,.11); border: 1rpx solid rgba(255,255,255,.12); border-radius: var(--r-pill); font-size: var(--fs-sm); }
.weather-temp { font-family: var(--font-num); font-size: var(--fs-lg); font-weight: 700; }
.home-weather { margin: 0 0 4rpx; }

/* ── 今日待办（去卡片化：容器卡 + 条目）── */
.task-stack { display: flex; flex-direction: column; margin-top: var(--s-2); background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); overflow: hidden; }
.task-card { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.task-card:last-child { border-bottom: 0; }
.task-card.warn { background: var(--corn-soft); }
.task-card.danger { background: var(--tomato-soft); }
.task-card.good { background: var(--green-50); }
.task-glyph { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: var(--green-700); background: var(--green-100); border-radius: var(--r-sm); font-size: var(--fs-sm); font-weight: 800; }
/* 着色条目上的字形章改白底，避免与底色融在一起 */
.task-card.warn .task-glyph { color: var(--corn-ink); background: var(--paper); }
.task-card.danger .task-glyph { color: var(--tomato-ink); background: var(--paper); }
.task-copy { flex: 1; min-width: 0; }
.task-title { display: block; color: var(--ink); font-size: var(--fs-base); font-weight: 700; }
.task-desc { display: block; margin-top: 6rpx; color: var(--muted); font-size: var(--fs-sm); line-height: 1.45; }
.task-action { flex: 0 0 auto; color: var(--green-700); font-size: var(--fs-sm); font-weight: 700; }

/* ── 常用工作（两个高频动作）── */
.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.action-card { min-height: 190rpx; padding: 24rpx; text-align: left; background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); transition: transform var(--dur-fast) var(--ease-spring); }
.action-card:active { transform: translateY(2rpx) scale(.99); }
.action-card icon { margin-bottom: var(--s-2); }
.action-card.action-primary { color: #fff; background: var(--green-800); border-color: transparent; box-shadow: 0 4rpx 12rpx rgba(42, 107, 60, .16); }
.action-card.action-primary icon { color: #fff !important; }
.action-title { display: block; margin-top: 8rpx; color: var(--ink); font-size: var(--fs-base); font-weight: 700; }
.action-primary .action-title { color: #fff; }
.action-desc { display: block; margin-top: 4rpx; color: var(--muted); font-size: var(--fs-sm); }
.action-primary .action-desc { color: rgba(255,255,255,.64); }

/* ── 今日建议（麦穗金点缀，走 v4.2 corn 令牌）── */
.today-advisor { display: flex; align-items: center; gap: var(--s-3); padding: 28rpx; background: linear-gradient(135deg, rgba(200, 144, 42, .10), rgba(42, 107, 60, .05)); border: 1rpx solid rgba(200, 144, 42, .28); border-radius: var(--r-lg); }
.today-advisor:active { opacity: .85; }
.ta-glyph { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: var(--r-lg); display: flex; align-items: center; justify-content: center; background: rgba(200, 144, 42, .16); }
.ta-copy { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.ta-title { font-size: var(--fs-base); font-weight: 700; color: var(--ink); }
.ta-desc { font-size: var(--fs-sm); color: var(--muted); }
.ta-arrow { font-size: var(--fs-xl); color: var(--corn-ink); }

/* ── 库存状态 ── */
.status-card { padding: 28rpx 18rpx; background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
.inventory-summary { display: flex; align-items: center; }
.summary-stat { flex: 1; text-align: center; }
.summary-num { display: block; color: var(--ink); font-family: var(--font-num); font-size: var(--fs-2xl); font-weight: 800; font-variant-numeric: tabular-nums; }
.summary-num.green { color: var(--green-800); }
.summary-num.red { color: var(--tomato); }
.summary-label { display: block; margin-top: 5rpx; color: var(--muted); font-size: var(--fs-xs); }
.summary-divider { width: 1rpx; height: 68rpx; background: var(--line); }
.data-note { display: block; margin: 14rpx 6rpx 0; color: var(--muted); font-size: var(--fs-xs); line-height: 1.5; }

/* ── 最近记录 ── */
.record-list { overflow: hidden; background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
.record-item { display: flex; align-items: center; gap: 18rpx; min-height: 92rpx; padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--line-soft); }
.record-item:last-child { border-bottom: 0; }
.record-bullet { flex: 0 0 auto; width: 26rpx; height: 26rpx; background: var(--green-100); border: 7rpx solid var(--green-700); border-radius: 50%; }
.record-text { flex: 1; color: var(--ink-2); font-size: var(--fs-sm); }

/* 空状态（小智） */
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 18rpx; padding: 50rpx 30rpx; text-align: center; color: var(--muted); background: var(--paper); border: 2rpx dashed var(--line); border-radius: var(--r-lg); font-size: var(--fs-sm); line-height: 1.55; }
