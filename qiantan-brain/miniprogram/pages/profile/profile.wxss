/* ============================================================
 * 「我的」页 v5.2 样式 —— 排版收敛版
 * 表面只剩两种：绿色快照 hero + 白瓷分组卡（card--flush/.list）；
 * 文字全部走 app.wxss 的 t-* 词汇表，本地只留布局与品牌细节。
 * ============================================================ */

.profile-page { padding-top: 22rpx; padding-bottom: 160rpx; }

/* ── ① 经营快照（金额/统计行走全局 hero DNA，这里只管周累计胶囊）── */
.snapshot-hero { padding-bottom: 34rpx; }
.snapshot-main { position: relative; z-index: 2; margin-top: 16rpx; }
/* 涨跌色（profile.js 的 dayChangeDir 是 up/down，映射到 hero 深底配色） */
.hero-stat-num.up { color: #8fe8ac; }
.hero-stat-num.down { color: #ffc79e; }
.snapshot-week {
  position: relative; z-index: 2; display: block; margin-top: 22rpx;
  padding: 14rpx 22rpx; background: rgba(255,255,255,.10);
  border-radius: var(--r-pill); font-size: var(--fs-sm);
  color: rgba(255,255,255,.82); text-align: center;
}

/* 骨架屏 */
.sk-bar { padding: 20rpx 0; position: relative; z-index: 2; }
.sk-bar .sk-line { height: 28rpx; margin: 12rpx 0; background: rgba(255,255,255,.16); }

/* ── 员工身份切换横条 ── */
.identity-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-top: var(--s-2); padding: 24rpx 28rpx;
  background: var(--paper); border: 1rpx solid var(--ring); border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}
.identity-bar.is-staff { border-left: 8rpx solid var(--green-700); }
.identity-info { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.identity-action { flex: 0 0 auto; font-size: var(--fs-sm); font-weight: 700; color: var(--primary); }

/* ── ② 常用功能：分组卡（上双格 + 下采购行）── */
.feature-grid { display: grid; grid-template-columns: 1fr 1fr; }
.feature-cell {
  display: flex; align-items: center; gap: 18rpx; padding: 28rpx 24rpx;
  transition: background var(--dur-fast) var(--ease-out);
}
.feature-cell:active { background: var(--paper-2); }
.feature-cell + .feature-cell { border-left: 1rpx solid var(--line-soft); }
.feature-copy { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.feature-row {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx; border-top: 1rpx solid var(--line-soft);
  transition: background var(--dur-fast) var(--ease-out);
}
.feature-row:active { background: var(--paper-2); }
.feature-row .feature-copy { flex: 1; }

/* ── ③ 设备状态点（配全局 .list）── */
.dev-status { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.dev-status.online { background: var(--green-500); box-shadow: 0 0 8rpx rgba(52, 168, 94, .45); }
.dev-status.unstable { background: var(--corn); }
.dev-status.offline { background: var(--tomato); }

/* ── ④ 工具格（配全局 .ui-quick-grid 网格；软底字块缩小一档更安静）── */
.tool-glyph {
  display: flex; align-items: center; justify-content: center;
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  font-size: 26rpx; font-weight: 800;
}
.tool-glyph.blue { color: var(--info-ink); background: var(--info-soft); }
.tool-glyph.corn { color: var(--corn-ink); background: var(--corn-soft); }
.tool-glyph.green { color: var(--green-800); background: var(--green-100); }

/* ── ⑤ 设置与帮助：帮助四格（分组卡内平底，hairline 由网格缝提供）── */
.help-wrap { padding: var(--s-2); border-top: 1rpx solid var(--line-soft); }
.help-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.help-item {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 20rpx 8rpx; background: var(--paper-2); border-radius: var(--r-md);
  transition: background var(--dur-fast) var(--ease-out);
}
.help-item:active { background: var(--paper-3); }
