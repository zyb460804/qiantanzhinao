        <view class="ui-result-icon">✓</view>
        <view class="ui-result-title">今日已日结</view>
        <view class="ui-result-desc">毛利 ¥743.50 · 已自动锁定账目</view>
        <view class="ui-result-desc" style="margin-top:2rpx;">明早 6:30 可开始新的经营日</view>
        <view class="ui-result-actions btn-row"><view class="btn-outline">看日结小票</view><view class="btn-primary">知道了</view></view>
      </view>
    </view>
    <view class="ui-quick-grid">
      <view class="ui-quick-cell"><text class="ui-quick-glyph">📦</text><text>进货</text></view>
      <view class="ui-quick-cell"><text class="ui-quick-glyph">🧾</text><text>盘点</text></view>
