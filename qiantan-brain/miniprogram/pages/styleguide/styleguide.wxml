  <view class="card card--spotlight bg-grid stagger--on" style="--spot: rgba(39, 145, 78, 0.10);">
    <view class="row" style="gap:40rpx;margin-bottom:24rpx;">
      <view class="ui-spinner"></view>
      <view class="ui-dots"><view></view><view></view><view></view></view>
